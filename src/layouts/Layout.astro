---
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  jsonLd?: object | object[];
}

const { title, description, canonical, ogImage = 'https://floci.io/og/home.png', jsonLd } = Astro.props;

const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "floci",
    "url": "https://floci.io",
    "description": "Free, MIT-licensed local cloud emulators for AWS, Azure, and GCP.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "floci",
    "url": "https://floci.io",
    "logo": "https://floci.io/floci-logo.svg",
    "sameAs": [
      "https://github.com/floci-io",
      "https://twitter.com/floci_io"
    ]
  }
];

const schemas = [
  ...baseSchema,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])
];
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="Floci">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@floci_io">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
<link rel="dns-prefetch" href="https://api.github.com">
<script defer src="https://cloud.umami.is/script.js" data-website-id="d4cade84-d61d-4384-82d5-59a8b7771ac4"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<meta name="theme-color" content="#0f1117">
<script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />
<style is:global>
  :root {
    --bg: #070B14; --bg2: #161E2E; --bg3: #0F1520;
    --border: #2A3142; --border-bright: #3D4559;
    --text: #F8FAFC; --text-muted: #94A3B8; --text-dim: #64748B;
    --accent: #7A7FD6; --accent-deep: #5559A7; --accent-cream: #E8E9F8;
    --accent-warm: #6368C2; --accent-dim: rgba(85,89,167,0.12);
    --indigo: #5559A7; --indigo-mid: #6368C2; --indigo-light: #7A7FD6;
    --green: #22c55e; --red: #ef4444;
    --mono: 'Space Mono', monospace; --sans: 'Sora', sans-serif;
    --nav-bg: rgba(7,11,20,0.92);
  }
  html.light {
    --bg: #F8FAFC; --bg2: #F1F5F9; --bg3: #E2E8F0;
    --border: #CBD5E1; --border-bright: #94A3B8;
    --text: #070B14; --text-muted: #5559A7; --text-dim: #94A3B8;
    --accent: #5559A7; --accent-cream: #E8E9F8; --accent-warm: #44488C;
    --accent-dim: rgba(85,89,167,0.1); --nav-bg: rgba(248,250,252,0.92);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; overflow-x: hidden; scroll-padding-top: 72px; }
  body {
    font-family: var(--sans); font-size: 18px;
    background: var(--bg); color: var(--text);
    line-height: 1.6; overflow-x: hidden;
    transition: background 0.25s, color 0.25s;
  }

  section { padding: 100px 2rem; }
  .container { max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-family: var(--mono); font-size: 12px;
    color: var(--indigo-light); letter-spacing: 3px; text-transform: uppercase;
    margin-bottom: 14px;
  }
  h2 { font-size: clamp(28px, 4vw, 44px); font-weight: 800; letter-spacing: -1px; margin-bottom: 16px; }
  .section-desc { color: var(--text-muted); font-size: 18px; max-width: 540px; }
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  .btn-primary {
    background: var(--accent-deep); color: #ffffff;
    padding: 13px 28px; border-radius: 8px; font-size: 15px; font-weight: 700;
    text-decoration: none; transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-primary:hover { background: var(--accent-warm); transform: translateY(-1px); }
  .btn-ghost {
    background: transparent; border: 1px solid var(--border-bright); color: var(--text);
    padding: 13px 28px; border-radius: 8px; font-size: 15px; font-weight: 500;
    text-decoration: none; transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.3)} }

  .code-block, .install-block { position: relative; }
  .copy-btn {
    position: absolute; top: 10px; right: 10px;
    background: var(--bg3); border: 1px solid var(--border);
    color: var(--text-dim); font-family: var(--mono); font-size: 11px;
    padding: 4px 10px; border-radius: 5px; cursor: pointer;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
    opacity: 0; pointer-events: none;
  }
  .code-block:hover .copy-btn, .install-block:hover .copy-btn,
  .copy-btn:focus { opacity: 1; pointer-events: auto; }
  .copy-btn:hover { color: var(--text); border-color: var(--border-bright); }
  .copy-btn.copied { color: var(--green); border-color: var(--green); opacity: 1; pointer-events: none; }
  .skip-link {
    position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden;
    font-size: 14px; color: var(--bg); background: var(--accent); padding: 8px 16px; border-radius: 0 0 8px 8px;
    text-decoration: none; font-weight: 600; z-index: 9999;
  }
  .skip-link:focus { left: 50%; transform: translateX(-50%); width: auto; height: auto; }

  /* ---- Shareable heading anchors ---- */
  .heading-anchor {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; margin-left: 8px; vertical-align: middle;
    color: var(--text-dim);
    -webkit-text-fill-color: currentColor;
    border-radius: 6px; opacity: 0;
    transition: opacity 0.15s, color 0.15s;
  }
  .heading-anchor svg { display: block; }
  h1:hover > .heading-anchor, h2:hover > .heading-anchor, h3:hover > .heading-anchor,
  .heading-anchor:hover, .heading-anchor:focus-visible { opacity: 1; }
  .heading-anchor:hover { color: var(--accent); }
  .heading-anchor:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .heading-anchor.copied { color: var(--green); opacity: 1; }
  @media (hover: none) { .heading-anchor { opacity: 0.4; } }

  @keyframes anchor-flash {
    0%   { background-color: var(--accent-dim); box-shadow: 0 0 0 8px var(--accent-dim); }
    100% { background-color: transparent;       box-shadow: 0 0 0 8px transparent; }
  }
  .anchor-flash { animation: anchor-flash 1.6s ease-out 1; border-radius: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .anchor-flash { animation: none; }
    .heading-anchor { transition: none; }
    html { scroll-behavior: auto; }
  }
</style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <slot />
  <script>
  document.querySelectorAll('a[target="_blank"]:not([rel~="noopener"])').forEach(function(a) {
    a.setAttribute('rel', 'noopener noreferrer');
  });
  document.querySelectorAll('.code-block, .install-block').forEach(function(block) {
    var btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    block.appendChild(btn);
    btn.addEventListener('click', function() {
      var pre = block.querySelector('pre');
      var text;
      if (pre) {
        text = pre.textContent.trim();
      } else {
        var div = document.createElement('div');
        div.innerHTML = block.innerHTML;
        var cb = div.querySelector('.copy-btn');
        if (cb) cb.remove();
        div.querySelectorAll('br').forEach(function(br) { br.replaceWith('\n'); });
        text = div.textContent.replace(/\xA0/g, ' ').trim();
      }
      navigator.clipboard.writeText(text).then(function() {
        btn.textContent = '✓ Copied';
        btn.classList.add('copied');
        setTimeout(function() { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 1500);
      }).catch(function() {});
    });
  });

  // ---- Shareable section anchors ----
  (function () {
    var LINK_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
    var CHECK_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
      return new Promise(function (resolve, reject) {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy') ? resolve() : reject(new Error('copy failed')); }
        catch (e) { reject(e); }
        finally { ta.remove(); }
      });
    }

    function addAnchor(heading, id) {
      if (heading.querySelector('.heading-anchor')) return;
      var a = document.createElement('a');
      a.className = 'heading-anchor';
      a.href = '#' + id;
      a.setAttribute('aria-label', 'Copy link to this section');
      a.innerHTML = LINK_ICON;
      a.addEventListener('click', function () {
        copyText(location.origin + location.pathname + '#' + id).then(function () {
          a.innerHTML = CHECK_ICON; a.classList.add('copied');
          a.setAttribute('aria-label', 'Link copied');
          setTimeout(function () {
            a.innerHTML = LINK_ICON; a.classList.remove('copied');
            a.setAttribute('aria-label', 'Copy link to this section');
          }, 1500);
        }).catch(function () {});
      });
      heading.appendChild(a);
    }

    document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach(function (h) {
      addAnchor(h, h.id);
    });

    document.querySelectorAll('section[id], section div[id]').forEach(function (el) {
      if (el.id === 'main-content') return;
      var h = el.querySelector('h2, h3');
      if (!h) return;
      if (h.closest('a')) return;
      if (h.closest('[id]') !== el) return;
      addAnchor(h, el.id);
    });

    function flashTarget() {
      var id = decodeURIComponent(location.hash.slice(1));
      if (!id || id === 'main-content') return;
      var el = document.getElementById(id);
      if (!el) return;
      var t = /^H[1-6]$/.test(el.tagName) ? el : (el.querySelector('h2, h3') || el);
      t.classList.remove('anchor-flash');
      void t.offsetWidth;
      t.classList.add('anchor-flash');
    }
    window.addEventListener('hashchange', flashTarget);
    if (location.hash) flashTarget();
  })();

  // ---- Scrollspy: keep the URL hash in sync while scrolling ----
  (function () {
    var targets = [].slice.call(document.querySelectorAll('section[id], .prose h2[id]'))
      .filter(function (el) { return el.id !== 'main-content'; });
    if (!targets.length) return;
    var timer = null;
    function currentId() {
      var doc = document.documentElement;
      if (window.innerHeight + window.scrollY >= doc.scrollHeight - 2) {
        return targets[targets.length - 1].id;
      }
      var current = '';
      for (var i = 0; i < targets.length; i++) {
        if (targets[i].getBoundingClientRect().top <= 121) current = targets[i].id;
      }
      return current;
    }
    function sync() {
      var id = currentId();
      if (('#' + id) === location.hash || (!id && !location.hash)) return;
      history.replaceState(null, '', id ? '#' + id : location.pathname + location.search);
    }
    window.addEventListener('scroll', function () {
      clearTimeout(timer);
      timer = setTimeout(sync, 150);
    }, { passive: true });
  })();
  </script>
</body>
</html>
