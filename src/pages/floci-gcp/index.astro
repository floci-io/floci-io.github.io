  /* SERVICE CARDS */
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1px; background: var(--border); border-radius: 12px; overflow: hidden; margin-top: 40px; }
  .svc-card { background: var(--bg2); padding: 28px 24px; transition: background 0.2s; }
  .svc-card:hover { background: var(--bg3); }
  .svc-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; font-size: 20px; }
  .svc-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .svc-card-head .svc-icon { margin-bottom: 0; }
  .svc-status { font-family: var(--mono); font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 4px; letter-spacing: .04em; }
  .svc-status.live    { background: rgba(52,168,83,0.15); color: var(--green); border: 1px solid rgba(52,168,83,0.3); }
  .svc-status.wip     { background: rgba(251,188,4,0.10); color: #fbbc04; border: 1px solid rgba(251,188,4,0.25); }
  .svc-status.planned { background: rgba(255,255,255,0.05); color: var(--text-dim); border: 1px solid var(--border); }
  .svc-status.soon    { background: rgba(255,255,255,0.03); color: var(--text-dim); border: 1px solid var(--border); }
  .svc-icon.storage { background: rgba(52,168,83,0.12); }
  .svc-icon.pubsub  { background: rgba(52,168,83,0.12); }
  .svc-icon.fire    { background: rgba(251,188,4,0.10); }
  .svc-icon.ds      { background: rgba(52,168,83,0.08); }
  .svc-icon.sm      { background: rgba(234,67,53,0.10); }
  .svc-icon.bq      { background: rgba(52,168,83,0.08); }
  .svc-name { font-weight: 700; font-size: 16px; margin-bottom: 6px; }
  .svc-desc { font-size: 13px; color: var(--text-muted); line-height: 1.5; }
