  .footer-links a { color: var(--text-muted); font-size: 14px; text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--text); }
  .footer-copy { font-size: 12px; color: var(--text-dim); font-family: var(--mono); }

</style>

<style is:global>
  /* Restore nav to Floci brand colors — page :root overrides bleed in otherwise */
  .nav-logo { color: #ffe082 !important; }
  .nav-links a.nav-cta { background: #34A853 !important; color: #000 !important; }
  nav { border-bottom-color: rgba(255,255,255,0.06) !important; }
  .nav-links a { color: rgba(121,134,203,0.85) !important; }
  .nav-links a:hover { color: #e8eaf6 !important; }
  .nav-links a.aws-link { color: rgba(255,153,0,0.85) !important; }
  .nav-links a.az-link  { color: rgba(0,120,212,0.85) !important; }
  .nav-links a.gcp-link { color: rgba(52,168,83,0.85) !important; }
  .nav-links a.aws-link.nav-active { color: #FF9900 !important; }
  .nav-links a.az-link.nav-active  { color: #0078D4 !important; }
  .nav-links a.gcp-link.nav-active { color: #34A853 !important; }
</style>

<script>
const burger = document.getElementById('navBurger');
const navLinks = document.getElementById('navLinks');
if (burger && navLinks) {
  burger.addEventListener('click', () => navLinks.classList.toggle('open'));
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));
}

const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});


fetch('https://api.github.com/repos/floci-io/floci-gcp').then(r => r.json()).then(data => {
  const count = data.stargazers_count;
  if (!count) return;
  const fmt = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : count;
  const nav = document.getElementById('ghNavStars');
  if (nav) nav.textContent = ' · ' + fmt;
}).catch(() => {});
</script>
