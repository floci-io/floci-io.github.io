  .svc-soon { font-size: 11px; font-family: var(--mono); color: #fbbc04; background: rgba(251,188,4,0.08); border: 1px solid rgba(251,188,4,0.2); border-radius: 4px; padding: 2px 7px; }

  /* NOTIFY / CTA */
  .notify-box { background: var(--bg2); border: 1px solid var(--border-bright); border-radius: 16px; padding: 48px; text-align: center; max-width: 600px; margin: 0 auto; }
