<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));


document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});

document.querySelectorAll('#installTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#installTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('itab-' + tab.getAttribute('data-tab'));
    if (target) target.style.display = 'block';
  });
});

document.querySelectorAll('#sdkTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#sdkTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="stab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('stab-' + tab.dataset.tab);
    if (target) target.style.display = 'block';
  });
});

fetch('https://api.github.com/repos/floci-io/floci-az').then(r => r.json()).then(data => {
  const count = data.stargazers_count;
  if (!count) return;
  const fmt = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : count;
  const nav = document.getElementById('ghNavStars');
  if (nav) nav.textContent = ' · ' + fmt;
  const btn = document.getElementById('ghStarsBtn');
  if (btn) btn.textContent = ' · ' + fmt;
}).catch(() => {});
</script>
