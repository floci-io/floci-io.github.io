---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const sectionLinks = [
  { href: '#services', label: 'Services' },
  { href: '#performance', label: 'Performance' },
  { href: '#quickstart', label: 'Quick Start' },
  { href: '#sdks', label: 'Examples' },
];
---

<Layout
  title="floci-az — Free Azure Emulator"
  description="floci-az is a fast, free, open-source Azure emulator. Blob, Queue, Table, Functions, App Configuration, Key Vault, Event Hubs, and Service Bus on a single port — no Azure account, MIT licensed."
  canonical="https://floci.io/floci-az/"
  ogImage="https://floci.io/og/az.png"
>
  <Nav active="az" githubUrl="https://github.com/floci-io/floci-az" docsUrl="https://github.com/floci-io/floci-az#readme" sectionLinks={sectionLinks} />


  <!-- HERO -->
  <section class="hero" id="main-content">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>

    <div class="hero-logo-wrap">
      <img src="/floci_az.svg" width="120" height="85" alt="floci Azure" />
    </div>

    <h1>Local Azure.<br><span class="accent">Zero cost.</span><br>Zero restrictions.</h1>
    <p class="hero-sub">
      floci-az is a fast, free, open-source Azure emulator built with Quarkus Native — no Azure account required.
    </p>
    <div class="hero-actions">
      <a href="#quickstart" class="btn-primary">Get Started →</a>
      <a href="https://github.com/floci-io/floci-az" class="btn-ghost" target="_blank">★ View on GitHub <span id="ghStarsBtn"></span></a>
    </div>
    <div class="hero-stats">
      <div class="stat-item"><span class="stat-number">4577</span><div class="stat-label">Default port</div><div class="stat-sub">all services on one port</div></div>
      <div class="stat-item"><span class="stat-number">8</span><div class="stat-label">Azure services</div><div class="stat-sub">Storage, Functions, App Config, Key Vault, Messaging</div></div>
      <div class="stat-item"><span class="stat-number">MIT</span><div class="stat-label">License</div><div class="stat-sub">fork, embed, extend freely</div></div>
      <div class="stat-item"><span class="stat-number">$0</span><div class="stat-label">Forever free</div><div class="stat-sub">no Azure account needed</div></div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" style="background:var(--bg2)">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Supported Services</div>
        <h2>Azure services. All of them free.</h2>
        <p class="section-desc">Wire-compatible with the official Azure SDKs and Azurite emulator — switch from real Azure with zero application code changes.</p>
      </div>
      <div class="services-grid reveal" style="transition-delay:0.1s">
        <!-- Blob Storage -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">🗄</div>
            <div><div class="service-card-name">Blob Storage</div><div class="service-card-proto">REST · XML · JSON</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Store and retrieve unstructured binary data — files, images, backups, logs. Full container and blob management via the standard Azure Storage REST API.</p>
            <ul class="feature-list">
              <li>Create, list, and delete containers</li>
              <li>Upload and download block blobs, append blobs</li>
              <li>Blob metadata and content type management</li>
              <li>Shared Access Signature (SAS) token support</li>
              <li>Batch operations and blob copying</li>
            </ul>
          </div>
        </div>
        <!-- Queue Storage -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">📨</div>
            <div><div class="service-card-name">Queue Storage</div><div class="service-card-proto">REST · JSON</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Reliable message queuing with FIFO semantics and visibility timeout. Perfect for decoupling components, scheduling background work, and buffering requests.</p>
            <ul class="feature-list">
              <li>Create and delete queues</li>
              <li>Enqueue, dequeue, and peek messages</li>
              <li>Visibility timeout control</li>
              <li>Message TTL and dequeue count</li>
              <li>Batch send and receive</li>
            </ul>
          </div>
        </div>
        <!-- Table Storage -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">📋</div>
            <div><div class="service-card-name">Table Storage</div><div class="service-card-proto">OData · REST · JSON</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Schemaless NoSQL key-value store accessed via OData. Store structured data with partition key + row key indexing, supporting rich query filtering.</p>
            <ul class="feature-list">
              <li>Create, list, and delete tables</li>
              <li>Insert, merge, replace, and delete entities</li>
              <li>OData filter expressions</li>
              <li>Batch transactions (entity group transactions)</li>
              <li>Continuation tokens for paging</li>
            </ul>
          </div>
        </div>
        <!-- Azure Functions -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">⚡</div>
            <div><div class="service-card-name">Azure Functions</div><div class="service-card-proto">HTTP · Timer · Storage Triggers</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Execute serverless functions locally with the same triggers and bindings as production Azure Functions. HTTP, Timer, Blob Storage, and Queue trigger support.</p>
            <ul class="feature-list">
              <li>HTTP trigger with all methods</li>
              <li>Timer trigger with cron expressions</li>
              <li>Node.js, Python, Java, and .NET runtimes</li>
              <li>Blob Storage input and output bindings</li>
              <li>Queue trigger and output bindings</li>
            </ul>
          </div>
        </div>
        <!-- App Configuration -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">⚙️</div>
            <div><div class="service-card-name">App Configuration</div><div class="service-card-proto">REST · Labels · Snapshots</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Centralized key-value store for app settings and feature flags with full label, revision history, snapshot, and lock support.</p>
            <ul class="feature-list">
              <li>Key-value CRUD with label filtering</li>
              <li>Immutable configuration snapshots</li>
              <li>Revision history and audit trail</li>
              <li>Read-only locks per key-value</li>
              <li>Full OData filter on list operations</li>
            </ul>
          </div>
        </div>
        <!-- Key Vault -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">🔐</div>
            <div><div class="service-card-name">Key Vault</div><div class="service-card-proto">REST · Secrets · Certificates · Keys</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Secrets, certificates, and cryptographic keys management with versioning, soft-delete recovery, and purge-protection semantics.</p>
            <ul class="feature-list">
              <li>Secrets with full version history</li>
              <li>Certificates and RSA/EC keys management</li>
              <li>Soft-delete and recovery operations</li>
              <li>Purge protection support</li>
              <li>32+ operations matching the Azure SDK</li>
            </ul>
          </div>
        </div>
        <!-- Event Hubs -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">📡</div>
            <div><div class="service-card-name">Event Hubs</div><div class="service-card-proto">AMQP · Kafka · REST</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">High-throughput event streaming with AMQP and Kafka protocol support. Consumer groups, partition management, and SAS token authentication.</p>
            <ul class="feature-list">
              <li>AMQP on ports 5672 (plain) / 5671 (TLS)</li>
              <li>Kafka protocol on port 9093</li>
              <li>Consumer group management</li>
              <li>Partition-level event routing</li>
              <li>SAS token and connection string auth</li>
            </ul>
          </div>
        </div>
        <!-- Service Bus -->
        <div class="service-card">
          <div class="service-card-head">
            <div class="service-card-icon">🚌</div>
            <div><div class="service-card-name">Service Bus</div><div class="service-card-proto">AMQP · Topics · Queues</div></div>
          </div>
          <div class="service-card-body">
            <p class="service-card-desc">Enterprise messaging with queues, topics, subscriptions, sessions, scheduled delivery, and dead-letter queue support over AMQP.</p>
            <ul class="feature-list">
              <li>AMQP on ports 5673 (plain) / 5674 (TLS)</li>
              <li>Topics with multiple subscriptions</li>
              <li>Session-based ordered delivery</li>
              <li>Scheduled message delivery</li>
              <li>Dead-letter queue and message deferral</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SELLING POINTS -->
  <section>
    <div class="container">
      <div class="reveal">
        <div class="section-label">Why floci-az</div>
        <h2>Drop-in. Native speed. No account.</h2>
        <p class="section-desc">The same native binary approach as floci (AWS) — applied to Azure. MIT licensed, no restrictions.</p>
      </div>
      <div class="cards-grid reveal" style="transition-delay:0.1s">
        <div class="card"><span class="card-num">MIT</span><h3>Free forever, no account</h3><p>MIT licensed. No subscription, no API key, no billing. Pull the Docker image and start using Azure SDKs against localhost immediately.</p></div>
        <div class="card"><span class="card-num">✓</span><h3>SDK compatible</h3><p>Uses the same Azurite-compatible connection string format. Switch from the real Azure or from Azurite by changing one endpoint URL.</p></div>
        <div class="card"><span class="card-num">⚡</span><h3>Native binary speed</h3><p>Compiled with GraalVM Mandrel — starts in 24ms, idles at ~13 MiB. Instant startup, minimal memory footprint.</p></div>
        <div class="card"><span class="card-num">1</span><h3>Single port (mostly)</h3><p>All REST services on port 4577. Event Hubs and Service Bus also expose AMQP ports so native SDK clients connect without any proxy layer.</p></div>
      </div>
    </div>
  </section>

  <!-- PERFORMANCE -->
  <section id="performance">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Performance</div>
        <h2>Fast. <span style="color:var(--accent)">Lightweight.</span> Zero overhead.</h2>
        <p class="section-desc">floci-az is built with Quarkus Native — the same stack as floci (AWS). Starts in 24ms, single Docker image, 8 services.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-top:40px" class="reveal" style="transition-delay:0.1s">
        <div style="background:var(--bg2);padding:28px 24px">
          <div style="font-family:var(--mono);font-size:32px;font-weight:700;color:var(--accent);margin-bottom:8px">24ms</div>
          <div style="font-size:14px;font-weight:600;margin-bottom:4px">Startup time</div>
          <div style="font-size:13px;color:var(--text-muted)">Quarkus Native binary</div>
        </div>
        <div style="background:var(--bg2);padding:28px 24px">
          <div style="font-family:var(--mono);font-size:32px;font-weight:700;color:var(--accent);margin-bottom:8px">1</div>
          <div style="font-size:14px;font-weight:600;margin-bottom:4px">Docker image</div>
          <div style="font-size:13px;color:var(--text-muted)">All services in a single container</div>
        </div>
        <div style="background:var(--bg2);padding:28px 24px">
          <div style="font-family:var(--mono);font-size:32px;font-weight:700;color:var(--accent);margin-bottom:8px">4577</div>
          <div style="font-size:14px;font-weight:600;margin-bottom:4px">Primary port</div>
          <div style="font-size:13px;color:var(--text-muted)">All 8 REST services — AMQP ports for Event Hubs &amp; Service Bus</div>
        </div>
        <div style="background:var(--bg2);padding:28px 24px">
          <div style="font-family:var(--mono);font-size:32px;font-weight:700;color:var(--accent);margin-bottom:8px">~13 MiB</div>
          <div style="font-size:14px;font-weight:600;margin-bottom:4px">Idle memory</div>
          <div style="font-size:13px;color:var(--text-muted)">Quarkus Native — minimal memory footprint</div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICKSTART -->
  <section id="quickstart" style="background:var(--bg2)">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Quick Start</div>
        <h2>Up in seconds.</h2>
        <p class="section-desc">Use the floci CLI for the smoothest experience, or run Docker directly if you prefer bare metal.</p>
      </div>

      <!-- method tabs -->
      <div class="qs-method-tabs reveal" id="qsMethodTabs" style="transition-delay:0.05s">
        <button class="qs-method-tab active" data-qs="cli">floci CLI</button>
        <button class="qs-method-tab" data-qs="docker">Docker</button>
      </div>

      <!-- floci CLI panel -->
      <div id="qspanel-cli" class="qs-panel reveal" style="transition-delay:0.1s">
        <div class="qs-grid">
          <div>
            <h3 style="margin-bottom:10px;font-size:16px;color:var(--text-muted);font-weight:500">1 · Install floci CLI</h3>
            <div class="code-tabs" id="installTabs">
              <button class="code-tab active" data-tab="brew">Homebrew</button>
              <button class="code-tab" data-tab="curl">curl</button>
              <button class="code-tab" data-tab="ps">PowerShell</button>
              <button class="code-tab" data-tab="scoop">Scoop</button>
            </div>
            <div id="itab-brew" class="code-block tabbed"><pre
><span class="cmd">brew install <span class="acc">floci-io/floci/floci</span></span></pre></div>
            <div id="itab-curl" class="code-block tabbed" style="display:none"><pre
><span class="cmd">curl -fsSL <span class="acc">https://floci.io/install.sh</span> | sh</span></pre></div>
            <div id="itab-ps" class="code-block tabbed" style="display:none"><pre
><span class="cmd">iwr <span class="acc">https://floci.io/install.ps1</span> | iex</span></pre></div>
            <div id="itab-scoop" class="code-block tabbed" style="display:none"><pre
><span class="cmd">scoop bucket add floci <span class="acc">https://github.com/floci-io/scoop-floci</span>
scoop install floci</span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">2 · Start the emulator</h3>
            <div class="code-block"><pre
><span class="cmd">floci az start</span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">3 · Export env vars</h3>
            <div class="code-block"><pre
><span class="cmd">eval $(floci az env)</span>
<span class="comment"># exports AZURE_STORAGE_CONNECTION_STRING</span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">4 · Upload a file</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="comment"># Create a container</span>
<span class="cmd">az storage container create \
  --name <span class="str">my-container</span> \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span></span>

<span class="comment"># Write a file and upload it</span>
<span class="cmd">echo <span class="str">"Azure locally — no bill, no drama. 🚀"</span> \
  &gt; hello-floci.txt
az storage blob upload \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-floci.txt \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span></span>

<span class="comment"># Download it back and read it</span>
<span class="cmd">az storage blob download \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-back.txt \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span>
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 style="margin-bottom:16px;font-size:16px;color:var(--text-muted);font-weight:500">Other useful commands</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="comment"># Check status</span>
<span class="cmd">floci az status</span>

<span class="comment"># View logs</span>
<span class="cmd">floci az logs</span>

<span class="comment"># Stop the emulator</span>
<span class="cmd">floci az stop</span>

<span class="comment"># Print individual SDK endpoint vars</span>
<span class="cmd">eval $(floci az env --format sdk-vars)</span>
<span class="comment"># exports AZURE_STORAGE_BLOB_ENDPOINT,</span>
<span class="comment"># AZURE_APP_CONFIGURATION_ENDPOINT,</span>
<span class="comment"># AZURE_KEY_VAULT_ENDPOINT, ...</span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">Start with persistence</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="cmd">floci az start --persist <span class="acc">./data</span></span>
<span class="comment"># state survives container restarts</span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">Diagnose issues</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="cmd">floci az doctor</span>
<span class="comment"># checks Docker, Azure CLI, connectivity</span></pre></div>
          </div>
        </div>
      </div>

      <!-- Docker panel -->
      <div id="qspanel-docker" class="qs-panel reveal" style="transition-delay:0.1s;display:none">
        <div class="qs-grid">
          <div>
            <h3 style="margin-bottom:16px;font-size:16px;color:var(--text-muted);font-weight:500">Docker</h3>
            <div class="code-block"><pre
><span class="comment"># REST :4577 · Event Hubs AMQP :5672 · Service Bus AMQP :5673</span>
<span class="cmd">docker run --rm \
  -p <span class="acc">4577:4577</span> \
  -p <span class="acc">5672:5672</span> \
  -p <span class="acc">5673:5673</span> \
  floci/floci-az:<span class="acc">latest</span></span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">docker-compose</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="cmd">services:
  floci-az:
    image: floci/floci-az:<span class="acc">latest</span>
    ports:
      - <span class="str">"4577:4577"</span></span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">Upload a file</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="cmd">az storage container create \
  --name <span class="str">my-container</span> \
  --connection-string <span class="acc">$CONN_STR</span>
echo <span class="str">"Azure locally — no bill, no drama. 🚀"</span> \
  &gt; hello-floci.txt
az storage blob upload \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-floci.txt \
  --connection-string <span class="acc">$CONN_STR</span>
az storage blob download \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-back.txt \
  --connection-string <span class="acc">$CONN_STR</span>
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 style="margin-bottom:16px;font-size:16px;color:var(--text-muted);font-weight:500">Connection string</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="comment"># Standard Azurite-compatible connection string</span>
<span class="cmd">DefaultEndpointsProtocol=http;
AccountName=<span class="acc">devstoreaccount1</span>;
AccountKey=<span class="acc">Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6I
  FsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==</span>;
BlobEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;
QueueEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;
TableEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;</span></pre></div>

            <h3 style="margin:28px 0 16px;font-size:16px;color:var(--text-muted);font-weight:500">Environment variable</h3>
            <div class="code-block" style="font-size:12px"><pre
><span class="cmd">export <span class="acc">CONN_STR</span>="DefaultEndpointsProtocol=http;\
AccountName=devstoreaccount1;\
AccountKey=Eby8vdM02xNOcq...;\
BlobEndpoint=http://localhost:4577/devstoreaccount1;"</span></pre></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SDK EXAMPLES -->
  <section id="sdks">
    <div class="container">
      <div class="reveal">
        <div class="section-label">SDK Examples</div>
        <h2>Works with every Azure SDK.</h2>
        <p class="section-desc">Use the standard Azure Storage SDK in any language — just point it at localhost:4577.</p>
      </div>
      <div class="reveal" style="transition-delay:0.1s;margin-top:48px">
        <div class="code-tabs" id="sdkTabs">
          <button class="code-tab active" data-tab="python">Python</button>
          <button class="code-tab" data-tab="java">Java</button>
          <button class="code-tab" data-tab="dotnet">.NET</button>
          <button class="code-tab" data-tab="js">JavaScript</button>
        </div>

        <div id="stab-python" class="code-block tabbed" style="font-size:13px;line-height:1.8">
          <span class="comment"># pip install azure-storage-blob</span><br>
          <span class="cmd">from azure.storage.blob import BlobServiceClient<br><br>
conn = (<br>
&nbsp;&nbsp;"DefaultEndpointsProtocol=http;"<br>
&nbsp;&nbsp;"AccountName=devstoreaccount1;"<br>
&nbsp;&nbsp;"AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;"<br>
&nbsp;&nbsp;"BlobEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;"<br>
)<br><br>
client = BlobServiceClient.from_connection_string(conn)<br>
container = client.create_container(<span class="str">"my-container"</span>)<br><br>
blob = client.get_blob_client(<span class="str">"my-container"</span>, <span class="str">"hello.txt"</span>)<br>
blob.upload_blob(<span class="str">b"Hello from floci-az!"</span>)</span>
        </div>

        <div id="stab-java" class="code-block tabbed" style="font-size:13px;line-height:1.8;display:none">
          <span class="comment">// azure-storage-blob:12.x</span><br>
          <span class="cmd">String conn = "DefaultEndpointsProtocol=http;"<br>
&nbsp;&nbsp;+ "AccountName=devstoreaccount1;"<br>
&nbsp;&nbsp;+ "AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;"<br>
&nbsp;&nbsp;+ "BlobEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;";<br><br>
BlobServiceClient client = new BlobServiceClientBuilder()<br>
&nbsp;&nbsp;.connectionString(conn)<br>
