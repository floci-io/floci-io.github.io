  /* EXAMPLES */
  .ex-tabs { display:flex; gap:4px; margin-top:40px; border-bottom:1px solid var(--border); flex-wrap:wrap; }
  .ex-tab { min-height:44px; padding:10px 22px; font-size:13px; font-family:var(--mono); color:var(--text-muted); background:transparent; border:none; border-bottom:2px solid transparent; cursor:pointer; transition:color 0.15s, border-color 0.15s; margin-bottom:-1px; }
  .ex-tab.active { color:var(--accent); border-bottom-color:var(--accent); }
  .ex-tab:hover:not(.active) { color:var(--text); }
  .ex-panel { display:none; margin-top:32px; }
  .ex-panel.active { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:32px; }
  @media (max-width:768px) { .ex-panel.active { grid-template-columns:minmax(0,1fr); } }
  .ex-label { font-size:12px; color:var(--text-muted); font-weight:500; margin-bottom:10px; font-family:var(--mono); letter-spacing:.04em; }

  /* FOOTER */
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; }

</style>


<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});


document.querySelectorAll('#installTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#installTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('itab-' + tab.getAttribute('data-tab'));
    if (target) target.style.display = 'block';
  });
});


document.querySelectorAll('#exTabs .ex-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#exTabs .ex-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.ex-panel').forEach(function(p) { p.classList.remove('active'); });
    const panel = document.getElementById('expanel-' + tab.dataset.ex);
    if (panel) panel.classList.add('active');
  });
});

</script>
