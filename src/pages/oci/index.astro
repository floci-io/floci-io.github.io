</Layout>

<style>
  :root {
    --bar-track: rgba(255,255,255,0.05); --row-hover: rgba(255,255,255,0.02);
    --accent-glow: rgba(199,70,52,0.25);
  }
  html.light {
    --row-hover: rgba(0,0,0,0.02);
    --accent-glow: rgba(199,70,52,0.15);
  }

  /* HERO */
  .hero { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 160px 2rem 80px; position: relative; overflow: hidden; }
  .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(199,70,52,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(199,70,52,0.06) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black, transparent); }
  .hero-glow { position: absolute; width: 700px; height: 350px; background: radial-gradient(ellipse at center, rgba(199,70,52,0.1), transparent 70%); top: 20%; left: 50%; transform: translateX(-50%); pointer-events: none; }
  .badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(199,70,52,0.08); border: 1px solid rgba(199,70,52,0.25); border-radius: 100px; padding: 6px 16px; font-size: 12px; color: var(--accent); font-family: var(--mono); margin-bottom: 28px; animation: fadeUp 0.6s ease both; }
  .badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse 2s ease-in-out infinite; flex-shrink: 0; }
  .hero h1 { font-size: clamp(44px, 7vw, 88px); font-weight: 800; line-height: 1.05; letter-spacing: -2px; margin-bottom: 24px; animation: fadeUp 0.6s 0.1s ease both; }
  .hero h1 .accent { color: #C74634; }
  .hero-sub { font-size: clamp(18px, 2vw, 22px); color: var(--text-muted); max-width: 580px; margin-bottom: 40px; font-weight: 300; animation: fadeUp 0.6s 0.2s ease both; }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; animation: fadeUp 0.6s 0.3s ease both; }

  /* HERO STATS */
  .hero-stats { display: flex; gap: 0; margin-top: 60px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; animation: fadeUp 0.6s 0.4s ease both; max-width: 720px; width: 100%; }
  .stat-item { flex: 1; padding: 24px 28px; border-right: 1px solid var(--border); background: var(--bg2); transition: background 0.2s; }
  .stat-item:last-child { border-right: none; }
  .stat-item:hover { background: var(--bg3); }
  @media (max-width: 580px) { .hero-stats { flex-wrap: wrap; } .stat-item { flex: 1 1 50%; border-right: none; border-bottom: 1px solid var(--border); padding: 18px 20px; } .stat-item:nth-child(odd) { border-right: 1px solid var(--border); } .stat-item:last-child { border-bottom: none; } }
  .stat-number { font-family: var(--mono); font-size: 28px; font-weight: 700; color: var(--accent); display: block; margin-bottom: 4px; }
  .stat-label { font-size: 12px; color: var(--text-muted); }
  .stat-sub { font-size: 11px; color: var(--text-dim); margin-top: 2px; }

  /* MARQUEE */
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  .hero-logo-wrap { animation: fadeUp 0.5s ease both; margin-bottom: 20px; }
  .hero-logo-svg { height: 72px; width: auto; animation: float 4s ease-in-out infinite; filter: drop-shadow(0 0 20px rgba(199,70,52,0.35)); }
  .hero-logo-svg .floci-text, .hero-logo-svg .floci-cloud { fill: #F8FAFC; }
  html.light .hero-logo-svg .floci-text { fill: #262425; }
  html.light .hero-logo-svg .floci-cloud { fill: #151515; }
  .hero-logo-svg .floci-dot.oci { fill: #C74634; }

  /* SERVICE CARDS */
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-top: 60px; }
  .services-grid::after { content: ''; grid-column: auto / -1; background: var(--bg); }
  .service-item { background: var(--bg); padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 10px; row-gap: 3px; transition: background 0.15s; cursor: pointer; color: inherit; text-decoration: none; }
  .service-item:hover { background: var(--bg3); }
  .service-icon { width: 16px; height: 16px; color: #C74634; flex-shrink: 0; grid-column: 1; grid-row: 1; }
  .service-item:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .service-name { font-size: 13px; font-weight: 500; grid-column: 2; grid-row: 1; }
  .service-proto { font-family: var(--mono); font-size: 10px; color: var(--text-dim); grid-column: 2; grid-row: 2; white-space: normal; overflow-wrap: anywhere; }
  .docker-mark { display: inline-block; width: 9px; height: 9px; margin-left: 6px; vertical-align: baseline; }
  .docker-mark.default { fill: var(--text-dim); }
  .docker-mark.optional { fill: none; stroke: var(--text-dim); stroke-width: 2; }
  .grid-legend { display: flex; gap: 22px; justify-content: flex-end; flex-wrap: wrap; margin-top: 14px; font-size: 12px; color: var(--text-dim); }
  .grid-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .grid-legend svg { width: 10px; height: 10px; }

  /* CODE */
  .code-block { background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 22px 24px; font-family: var(--mono); font-size: 13px; color: var(--text-muted); line-height: 2; overflow-x: auto; }
  .code-block pre { margin: 0; padding: 0; font: inherit; color: inherit; white-space: pre; background: none; border: none; overflow: visible; line-height: inherit; }
  .code-block .cmd { color: var(--text); }
  .code-block .comment { color: var(--text-dim); }
  .code-block .acc { color: var(--accent); }
  .code-block .str { color: #a5d6a7; }
  .code-tabs { display: flex; gap: 2px; border: 1px solid var(--border); border-bottom: none; border-radius: 10px 10px 0 0; overflow: hidden; background: var(--bg3); }
  .code-tab { padding: 10px 18px; font-size: 12px; color: var(--text-muted); cursor: pointer; font-family: var(--mono); border: none; background: transparent; transition: all 0.15s; }
  .code-tab.active { background: var(--bg2); color: var(--text); }
  .code-block.tabbed { border-radius: 0 0 10px 10px; }
  .qs-method-tabs { display: flex; gap: 4px; margin-top: 40px; border-bottom: 1px solid var(--border); }
  .qs-method-tab { padding: 10px 22px; font-size: 13px; font-family: var(--mono); color: var(--text-muted); background: transparent; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; margin-bottom: -1px; }
  .qs-method-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .qs-method-tab:hover:not(.active) { color: var(--text); }
  .qs-panel { margin-top: 36px; }
  .qs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
  @media (max-width: 768px) { .qs-grid { grid-template-columns: 1fr; } }

  /* SELLING POINTS */
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-top: 56px; }
  .card { background: var(--bg2); padding: 32px 28px; transition: background 0.2s; }
  .card:hover { background: var(--bg3); }
  .card h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; }
  .card p { font-size: 15px; color: var(--text-muted); line-height: 1.6; }
  .card-num { font-family: var(--mono); font-size: 28px; font-weight: 700; color: var(--accent); display: block; margin-bottom: 12px; }

  /* CONNECTION TABLE */
  .conn-table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 36px; }
  .conn-table th { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); font-weight: 600; color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; background: var(--bg2); }
  .conn-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); color: var(--text-muted); font-size: 13px; }
  .conn-table td:first-child { color: var(--text); font-weight: 500; }
  .conn-table td code { font-family: var(--mono); font-size: 12px; background: var(--bg3); padding: 2px 6px; border-radius: 3px; color: var(--accent); }
  .conn-table tr:last-child td { border-bottom: none; }
  .conn-wrap { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }

  /* CTA BANNER */
  .cta-banner { background: rgba(199,70,52,0.05); border: 1px solid rgba(199,70,52,0.18); border-radius: 12px; padding: 40px; text-align: center; margin-top: 60px; }
  .cta-banner h3 { font-size: 26px; font-weight: 800; margin-bottom: 10px; }
  .cta-banner p { color: var(--text-muted); font-size: 16px; max-width: 480px; margin: 0 auto 24px; }

  @media (max-width: 480px) { .hero { padding: 120px 1.5rem 60px; } section { padding: 80px 1.5rem; } }

</style>

<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));


document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});

document.querySelectorAll('#installTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#installTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('itab-' + tab.getAttribute('data-tab'));
    if (target) target.style.display = 'block';
  });
});

document.querySelectorAll('#sdkTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#sdkTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="stab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('stab-' + tab.dataset.tab);
    if (target) target.style.display = 'block';
  });
});

fetch('https://api.github.com/repos/floci-io/floci-oci').then(r => r.json()).then(data => {
  const count = data.stargazers_count;
  if (!count) return;
  const fmt = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : count;
  const nav = document.getElementById('ghNavStars');
  if (nav) nav.textContent = ' · ' + fmt;
  const btn = document.getElementById('ghStarsBtn');
  if (btn) btn.textContent = ' · ' + fmt;
}).catch(() => {});
</script>
