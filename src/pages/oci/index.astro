---
import CloudPage from '../../layouts/CloudPage.astro';
import { OCI_SERVICES } from '../../data/cloud-services';
import { SERVICE_COUNTS } from '../../data/services';

// Services that launch a Docker container, from the service data, so the copy can't drift from the grid.
const dockerServices = OCI_SERVICES.filter((s) => s.docker).map((s) => s.name);
const inProcessCount = OCI_SERVICES.length - dockerServices.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "floci-oci",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "license": "https://opensource.org/licenses/MIT",
  "url": "https://floci.io/oci/",
  "downloadUrl": "https://github.com/floci-io/floci-oci",
  "description": "Free Oracle Cloud Infrastructure (OCI) emulator. Object Storage, Identity, Queue, Streaming, KMS, Vault Secrets and Functions on a single port. No Oracle Cloud account required.",
  "keywords": "OCI emulator, Oracle Cloud emulator, local OCI, Object Storage mock, OCI SDK local"
};
---

<CloudPage
  cloud="oci"
  title="floci-oci: Free Oracle Cloud (OCI) Emulator"
  description="floci-oci is a fast, free, open-source Oracle Cloud Infrastructure (OCI) emulator. Object Storage, Identity (IAM), Queue, Streaming, KMS, Vault Secrets, and Functions on a single port. No Oracle Cloud account required, MIT licensed."
  canonical="https://floci.io/oci/"
  ogImage="https://floci.io/og/oci.png"
  jsonLd={jsonLd}
  docsHref="/floci-oci/"
  services={OCI_SERVICES}
  servicesDesc="Wire-compatible with the official OCI SDKs, the OCI CLI, Terraform and OpenTofu. Point your existing tools at localhost and keep your workflows."
>
  <section slot="quickstart" id="quickstart">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Quick Start</div>
        <h2>Every way to run it.</h2>
        <p class="section-desc">One CLI installs and runs all four emulators: use Homebrew, the install script or PowerShell. Or skip the CLI and run the Docker image.</p>
      </div>

      <!-- method tabs -->
      <div class="qs-method-tabs reveal reveal-delay-sm" id="qsMethodTabs">
        <button class="qs-method-tab active" data-qs="cli">floci CLI</button>
        <button class="qs-method-tab" data-qs="docker">Docker</button>
      </div>

      <!-- floci CLI panel -->
      <div id="qspanel-cli" class="qs-panel reveal reveal-delay">
        <div class="qs-grid">
          <div>
            <h3 class="qs-step">1 · Install floci CLI</h3>
            <div class="code-tabs" id="installTabs">
              <button class="code-tab active" data-tab="brew">Homebrew</button>
              <button class="code-tab" data-tab="curl">curl</button>
              <button class="code-tab" data-tab="ps">PowerShell</button>
            </div>
            <div id="itab-brew" class="code-block tabbed" data-lang="bash"><pre
><span class="cmd">brew install <span class="acc">floci-io/floci/floci</span></span></pre></div>
            <div id="itab-curl" class="code-block tabbed" style="display:none" data-lang="bash"><pre
><span class="cmd">curl -fsSL <span class="acc">https://floci.io/install.sh</span> | sh</span></pre></div>
            <div id="itab-ps" class="code-block tabbed" style="display:none" data-lang="bash"><pre
><span class="cmd">iwr <span class="acc">https://floci.io/install.ps1</span> | iex</span></pre></div>

            <h3 class="qs-step">2 · Start the emulator</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci oci start</span></pre></div>

            <h3 class="qs-step">3 · One-time setup &amp; env vars</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># creates a throwaway API key + ~/.oci/config profile</span>
<span class="cmd">floci oci setup</span>
<span class="cmd">eval $(floci oci env)</span>
<span class="cmd">export <span class="acc">TENANCY_OCID</span>=ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000</span></pre></div>

            <h3 class="qs-step">4 · Upload a file</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Create a bucket</span>
<span class="cmd">oci os bucket create \
  --namespace-name <span class="str">floci-local</span> \
  --name <span class="str">my-bucket</span> \
  --compartment-id <span class="acc">$TENANCY_OCID</span></span>

<span class="comment"># Write a file and upload it</span>
<span class="cmd">echo <span class="str">"Oracle Cloud locally: no bill, no drama."</span> \
  &gt; hello-floci.txt
oci os object put \
  --namespace-name <span class="str">floci-local</span> \
  --bucket-name <span class="str">my-bucket</span> \
  --file hello-floci.txt</span>

<span class="comment"># Download it back and read it</span>
<span class="cmd">oci os object get \
  --namespace-name <span class="str">floci-local</span> \
  --bucket-name <span class="str">my-bucket</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-back.txt
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 class="qs-step">Teach your coding agent</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Asks which agents to install it for</span>
<span class="cmd">npx skills add <span class="acc">floci-io/floci-cli</span></span></pre></div>
            <p class="qs-note">The Floci skill teaches Claude Code, Codex, Cursor, Kiro and other coding agents to run the emulators with floci-cli.</p>

            <h3 class="qs-step">Other useful commands</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Check status</span>
<span class="cmd">floci oci status</span>

<span class="comment"># View logs</span>
<span class="cmd">floci oci logs</span>

<span class="comment"># Stop the emulator</span>
<span class="cmd">floci oci stop</span>

<span class="comment"># List enabled OCI services</span>
<span class="cmd">floci oci services</span>

<span class="comment"># Poll until ready (CI-friendly)</span>
<span class="cmd">floci oci wait</span></pre></div>

            <h3 class="qs-step">Start with persistence</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci oci start --persist <span class="acc">./data</span></span>
<span class="comment"># state survives container restarts</span></pre></div>

            <h3 class="qs-step">Diagnose issues</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci oci doctor</span>
<span class="comment"># checks Docker, OCI CLI, connectivity</span></pre></div>
          </div>
        </div>
      </div>

      <!-- Docker panel -->
      <div id="qspanel-docker" class="qs-panel reveal reveal-delay" style="display:none">
        <div class="qs-grid">
          <div>
            <h3 class="qs-step">Docker</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># All services on :4599 · socket mount is for Functions and OKE</span>
<span class="cmd">docker run -d --name floci-oci \
  -p <span class="acc">4599:4599</span> \
  -v /var/run/docker.sock:/var/run/docker.sock \
  floci/floci-oci:<span class="acc">latest</span></span></pre></div>

            <h3 class="qs-step">docker-compose</h3>
            <div class="code-block" data-lang="yaml"><pre
><span class="cmd">services:
  floci-oci:
    image: floci/floci-oci:<span class="acc">latest</span>
    ports:
      - <span class="str">"4599:4599"</span>
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock</span></pre></div>

            <h3 class="qs-step">Throwaway key and OCI config</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Adds a separate [FLOCI] profile; your existing OCI profiles are left untouched</span>
<span class="cmd">mkdir -p ~/.oci
[ -f ~/.oci/floci_key.pem ] || openssl genrsa -out ~/.oci/floci_key.pem 2048
grep -qs '^\[FLOCI\]' ~/.oci/config || cat &gt;&gt; ~/.oci/config &lt;&lt;'EOF'
[FLOCI]
user=ocid1.user.oc1..anyuser
fingerprint=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
tenancy=ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000
region=us-ashburn-1
key_file=~/.oci/floci_key.pem
EOF
export OCI_CLI_PROFILE=FLOCI</span></pre></div>

            <h3 class="qs-step">Upload a file</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">export <span class="acc">TENANCY_OCID</span>=ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000</span>
<span class="cmd">oci os bucket create \
  --endpoint <span class="acc">http://localhost:4599</span> \
  --namespace-name <span class="str">floci-local</span> \
  --name <span class="str">my-bucket</span> \
  --compartment-id <span class="acc">$TENANCY_OCID</span>
echo <span class="str">"Oracle Cloud locally: no bill, no drama."</span> \
  &gt; hello-floci.txt
oci os object put \
  --endpoint <span class="acc">http://localhost:4599</span> \
  --namespace-name <span class="str">floci-local</span> \
  --bucket-name <span class="str">my-bucket</span> \
  --file hello-floci.txt
oci os object get \
  --endpoint <span class="acc">http://localhost:4599</span> \
  --namespace-name <span class="str">floci-local</span> \
  --bucket-name <span class="str">my-bucket</span> \
  --name hello-floci.txt --file hello-back.txt
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 class="qs-step">Health check</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">curl http://localhost:<span class="acc">4599</span>/_floci-oci/health</span></pre></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section slot="examples" id="examples">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Examples</div>
        <h2>Python, Java and the OCI CLI.</h2>
        <p class="section-desc">Use the standard OCI SDK in any language and point it at localhost:4599.</p>
      </div>
      <div class="reveal reveal-delay examples-body">
        <div class="code-tabs" id="sdkTabs">
          <button class="code-tab active" data-tab="python">Python</button>
          <button class="code-tab" data-tab="java">Java</button>
          <button class="code-tab" data-tab="cli">OCI CLI</button>
        </div>

        <div id="stab-python" class="code-block tabbed" data-lang="python">
          <span class="comment"># pip install oci</span><br>
          <span class="cmd">import oci<br><br>
config = {"{"}<br>
&nbsp;&nbsp;<span class="str">"user"</span>: <span class="str">"ocid1.user.oc1..anyuser"</span>,<br>
&nbsp;&nbsp;<span class="str">"fingerprint"</span>: <span class="str">"aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"</span>,<br>
&nbsp;&nbsp;<span class="str">"tenancy"</span>: <span class="str">"ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000"</span>,<br>
&nbsp;&nbsp;<span class="str">"region"</span>: <span class="str">"us-ashburn-1"</span>,<br>
&nbsp;&nbsp;<span class="str">"key_file"</span>: <span class="str">"~/.oci/floci_key.pem"</span>,  <span class="comment"># any locally generated key</span><br>
{"}"}<br><br>
client = oci.object_storage.ObjectStorageClient(<br>
&nbsp;&nbsp;config, service_endpoint=<span class="str">"http://localhost:<span class="acc">4599</span>"</span>)<br><br>
namespace = client.get_namespace().data<br>
try:<br>
&nbsp;&nbsp;&nbsp;&nbsp;client.create_bucket(namespace, oci.object_storage.models.CreateBucketDetails(<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;name=<span class="str">"python-bucket"</span>, compartment_id=config[<span class="str">"tenancy"</span>]))<br>
except oci.exceptions.ServiceError as e:<br>
&nbsp;&nbsp;&nbsp;&nbsp;if e.status != 409:  <span class="comment"># 409: created on an earlier run</span><br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;raise<br>
client.put_object(namespace, <span class="str">"python-bucket"</span>, <span class="str">"hello.txt"</span>, <span class="str">b"Hello from floci-oci!"</span>)</span>
        </div>

        <div id="stab-java" class="code-block tabbed" style="display:none" data-lang="java">
          <span class="comment">// com.oracle.oci.sdk:oci-java-sdk</span><br>
          <span class="cmd">var auth = SimpleAuthenticationDetailsProvider.builder()<br>
&nbsp;&nbsp;.tenantId(<span class="str">"ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000"</span>)<br>
&nbsp;&nbsp;.userId(<span class="str">"ocid1.user.oc1..anyuser"</span>)<br>
&nbsp;&nbsp;.fingerprint(<span class="str">"aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"</span>)<br>
&nbsp;&nbsp;.privateKeySupplier(new SimplePrivateKeySupplier(<br>
&nbsp;&nbsp;&nbsp;&nbsp;System.getProperty(<span class="str">"user.home"</span>) + <span class="str">"/.oci/floci_key.pem"</span>))<br>
&nbsp;&nbsp;.region(Region.US_ASHBURN_1)<br>
&nbsp;&nbsp;.build();<br><br>
ObjectStorageClient client = ObjectStorageClient.builder().build(auth);<br>
client.setEndpoint(<span class="str">"http://localhost:<span class="acc">4599</span>"</span>);<br><br>
String namespace = client.getNamespace(GetNamespaceRequest.builder().build()).getValue();<br>
try &#123;<br>
client.createBucket(CreateBucketRequest.builder()<br>
&nbsp;&nbsp;.namespaceName(namespace)<br>
&nbsp;&nbsp;.createBucketDetails(CreateBucketDetails.builder()<br>
&nbsp;&nbsp;&nbsp;&nbsp;.name(<span class="str">"java-bucket"</span>).compartmentId(auth.getTenantId()).build())<br>
&nbsp;&nbsp;.build());<br>
&#125; catch (BmcException e) &#123;<br>
&nbsp;&nbsp;if (e.getStatusCode() != 409) throw e;  <span class="comment">// 409: created on an earlier run</span><br>
&#125;</span>
        </div>

        <div id="stab-cli" class="code-block tabbed" style="display:none" data-lang="bash">
          <span class="comment"># Every OCI CLI command works with --endpoint</span><br>
          <span class="cmd">oci os ns get --endpoint http://localhost:<span class="acc">4599</span><br><br>
oci iam compartment list \<br>
&nbsp;&nbsp;--endpoint http://localhost:<span class="acc">4599</span> \<br>
&nbsp;&nbsp;--compartment-id <span class="str">ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000</span><br><br>
<span class="comment"># Or let the floci CLI wire the endpoint for you</span><br>
floci oci setup &amp;&amp; eval $(floci oci env)<br>
oci os ns get</span>
        </div>
      </div>

      <!-- Connection reference table -->
      <div class="reveal reveal-delay-lg migrate-table">
        <h3 class="table-title">Default connection values</h3>
        <p class="table-intro">floci-oci parses request signatures for tenancy and user context but never verifies them, so any locally generated API key works.</p>
        <div class="conn-wrap">
          <table class="conn-table">
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              <tr><td>Endpoint</td><td><code>http://localhost:4599</code></td></tr>
              <tr><td>Namespace</td><td><code>floci-local</code></td></tr>
              <tr><td>Tenancy OCID</td><td><code>ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000</code></td></tr>
              <tr><td>Region</td><td><code>us-ashburn-1</code></td></tr>
              <tr><td>API key</td><td><code>any locally generated RSA key</code></td></tr>
              <tr><td>Health check</td><td><code>http://localhost:4599/_floci-oci/health</code></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section slot="why" id="why">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Why floci-oci</div>
        <h2>No account. No key ceremony.</h2>
        <p class="section-desc">Object Storage, Queue, Streaming, KMS, Vault, Functions and OKE on one port, with throwaway keys in place of real credentials.</p>
      </div>
      <div class="hairline reveal reveal-delay"><div class="hairline-grid cols-4">
        <div><h3>Any key works</h3><p>Request signatures are parsed for tenancy and user context but never verified, so any locally generated API key works with the OCI SDKs, the OCI CLI, Terraform and OpenTofu.</p></div>
        <div><h3>Real crypto, real Functions</h3><p>KMS performs real AES-GCM, RSA and ECDSA operations. Functions invocations run your real FDK image through an Fn Project sidecar, not a mock.</p></div>
        <div><h3>One port, few containers</h3><p>Every service answers on port 4599. {dockerServices.join(' and ')} launch Docker containers; the other {inProcessCount} services run entirely in-process.</p></div>
        <div><h3>Native binary speed</h3><p>Starts in 24 ms and idles at ~13 MiB, fast enough to start a fresh emulator for every test run.</p></div>
      </div></div>
    </div>
  </section>
</CloudPage>

<style>
  :root {
    --bar-track: rgba(255,255,255,0.05); --row-hover: rgba(255,255,255,0.02);
  }
  html.light {
    --row-hover: rgba(0,0,0,0.02);
  }

  /* CODE */
  .qs-method-tabs { display: flex; gap: 4px; margin-top: 40px; border-bottom: 1px solid var(--border); }
  .qs-method-tab { min-height: 44px; padding: 10px 22px; font-size: 13px; font-family: var(--mono); color: var(--text-muted); background: transparent; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; margin-bottom: -1px; }
  .qs-method-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .qs-method-tab:hover:not(.active) { color: var(--text); }
  .qs-panel { margin-top: 36px; }
  .qs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; }
  @media (max-width: 768px) { .qs-grid { grid-template-columns: minmax(0, 1fr); } }

  /* CONNECTION TABLE */

</style>

<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));


document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});

document.querySelectorAll('#installTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#installTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('itab-' + tab.getAttribute('data-tab'));
    if (target) target.style.display = 'block';
  });
});

document.querySelectorAll('#sdkTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#sdkTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="stab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('stab-' + tab.dataset.tab);
    if (target) target.style.display = 'block';
  });
});

</script>
