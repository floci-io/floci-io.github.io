---
import { getCollection } from 'astro:content';
import { assertChronicleEntries, chroniclePublicSlug } from '../../lib/chronicle';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('chronicle', ({ data }) => !data.draft);
  assertChronicleEntries(posts);
  return posts.map(post => ({
    params: { slug: chroniclePublicSlug(post) },
  }));
}

const { slug } = Astro.params;
const dest = `/chronicle/${slug}/`;
const canonical = `https://floci.io${dest}`;
---

<meta http-equiv="refresh" content={`0;url=${dest}`}>
<link rel="canonical" href={canonical}>
<script define:vars={{ dest }}>window.location.replace(dest + window.location.search + window.location.hash)</script>
<a href={dest}>Continue to this article in the floci Chronicle</a>
