---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog — floci"
  description="Thoughts on local cloud development, open source, and developer tooling from the floci team."
  canonical="https://floci.io/blog/"
>
  <Nav active="blog" />

  <section class="page-hero">
    <div class="container">
      <div class="section-label">Writing</div>
      <h1>Blog</h1>
      <p class="hero-sub">Thoughts on local cloud development, open source, and developer tooling.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="empty">No posts yet — check back soon.</p>
      ) : (
        <div class="card-grid">
          {posts.map(post => (
            <a href={`/blog/${post.slug}/`} class="post-card">
              <div class="card-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="card-cta">Read →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer variant="sub" />
</Layout>

<style>
  .page-hero {
    padding: 140px 2rem 60px;
    border-bottom: 1px solid var(--border);
  }
  .page-hero h1 {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 800;
    letter-spacing: -2px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .hero-sub {
    color: var(--text-muted);
    font-size: 18px;
    max-width: 520px;
  }
  .content-section { padding: 80px 2rem 120px; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s;
  }
  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .card-meta time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-dim);
  }
  .tag {
    font-family: var(--mono);
    font-size: 11px;
    padding: 2px 8px;
    background: var(--accent-dim);
    color: var(--accent);
    border-radius: 4px;
  }
  .post-card h2 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.3;
  }
  .post-card p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }
  .card-cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 4px;
  }
  .empty {
    color: var(--text-dim);
    font-size: 16px;
  }
</style>
