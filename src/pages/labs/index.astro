---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getAuthor } from '../../data/authors';
import { LAB_CLOUD_COLOR, LAB_CLOUD_LABEL } from '../../data/labs';

const labs = (await getCollection('labs', ({ data }) => !data.draft || import.meta.env.DEV))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

---

<Layout
  title="101 Labs · floci"
  description="Hands-on labs for learning AWS, Azure, GCP, and OCI emulation with floci. No cloud account needed."
  canonical="https://floci.io/labs/"
  ogImage="https://floci.io/og/labs.png"
>
  <Nav active="labs" />

  <main id="main-content" tabindex="-1">

  <section class="page-hero">
    <div class="container">
      <div class="section-label">Hands-on</div>
      <h1>101 Labs</h1>
      <p class="hero-sub">Step-by-step guides for AWS, Azure, GCP, and OCI that run entirely on your laptop. No account needed.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      {labs.length === 0 ? (
        <p class="empty">No labs yet. Check back soon.</p>
      ) : (
        <div class="card-grid">
          {labs.map(lab => (
            <a href={`/labs/${lab.slug}/`} class="lab-card" style={`--cloud-color: ${LAB_CLOUD_COLOR[lab.data.cloud]}`}>
              <div class="lab-badges">
                <span class="cloud-badge">
                  {LAB_CLOUD_LABEL[lab.data.cloud]}
                </span>
                <span class="diff-badge" data-difficulty={lab.data.difficulty}>
                  {lab.data.difficulty}
                </span>
                <span class="dur-badge">⏱ {lab.data.duration}</span>
                <span class="author-badge">by {getAuthor(lab.data.author).name}</span>
              </div>
              <h2>{lab.data.title}</h2>
              <p>{lab.data.description}</p>
              {lab.data.tags.length > 0 && (
                <div class="tag-row">
                  {lab.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
              <span class="card-cta">Start lab →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  </main>

  <Footer variant="sub" />
</Layout>

<style>
  .page-hero {
    padding: 140px 2rem 60px;
    border-bottom: 1px solid var(--border);
  }
  .page-hero h1 {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 800;
    letter-spacing: -2px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .hero-sub {
    color: var(--text-muted);
    font-size: 18px;
    max-width: 520px;
  }
  .content-section { padding: 80px 2rem 120px; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 24px;
  }
  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s;
  }
  .lab-card:hover {
    border-color: var(--cloud-color);
    transform: translateY(-2px);
  }
  .lab-card:focus-visible { border-color: var(--cloud-color); outline: 2px solid var(--accent); outline-offset: 2px; }
  .lab-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cloud-badge, .diff-badge, .dur-badge, .author-badge {
    font-family: var(--mono);
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 4px;
  }
  /* The cloud hue colours the text only (Thin Marker Rule); a tinted fill dropped it below 4.5:1. */
  .cloud-badge { color: var(--cloud-color); border: 1px solid var(--border); }
  .diff-badge[data-difficulty="beginner"] { color: var(--green-text); }
  .diff-badge[data-difficulty="intermediate"] { color: var(--accent); }
  .diff-badge[data-difficulty="advanced"] { color: var(--red-text); }
  .diff-badge {
    background: transparent;
    text-transform: capitalize;
  }
  .dur-badge, .author-badge {
    color: var(--text-dim);
  }
  .lab-card h2 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.3;
  }
  .lab-card p {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }
  .tag-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag {
    font-family: var(--mono);
    font-size: 11px;
    padding: 2px 8px;
    background: var(--accent-dim);
    color: var(--text-muted);
    border-radius: 4px;
  }
  .card-cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--cloud-color);
    margin-top: 4px;
  }
  @media (max-width: 480px) {
    .content-section { padding-inline: 16px; }
    .lab-card { padding: 24px; }
  }
  .empty {
    color: var(--text-dim);
    font-size: 16px;
  }
</style>
