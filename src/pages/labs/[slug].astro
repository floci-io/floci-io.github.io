---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getCollection } from 'astro:content';
import { authorJsonLd, getAuthor } from '../../data/authors';
import { LAB_CLOUD_COLOR, LAB_CLOUD_LABEL } from '../../data/labs';

export async function getStaticPaths() {
  const labs = await getCollection('labs', ({ data }) => !data.draft || import.meta.env.DEV);
  return labs.map(lab => ({ params: { slug: lab.slug }, props: { lab } }));
}

const { lab } = Astro.props;
const { Content } = await lab.render();

const color = LAB_CLOUD_COLOR[lab.data.cloud];
const author = getAuthor(lab.data.author);
const canonical = `https://floci.io/labs/${lab.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: lab.data.title,
  description: lab.data.description,
  url: canonical,
  mainEntityOfPage: canonical,
  proficiencyLevel: lab.data.difficulty,
  author: authorJsonLd(lab.data.author),
  publisher: { '@type': 'Organization', name: 'floci', url: 'https://floci.io' },
};
---

<Layout
  title={`${lab.data.title} · floci 101 Labs`}
  description={lab.data.description}
  canonical={canonical}
  ogImage="https://floci.io/og/labs.png"
  jsonLd={jsonLd}
>
  <Nav active="labs" />

  <main id="main-content" tabindex="-1">

  <article class="article" style={`--cloud-color: ${color}`}>
    <div class="container">
      <a href="/labs/" class="back-link">← 101 Labs</a>

      <header class="article-header">
        <div class="lab-badges">
          <span class="cloud-badge">
            {LAB_CLOUD_LABEL[lab.data.cloud]}
          </span>
          <span class="diff-badge" data-difficulty={lab.data.difficulty}>
            {lab.data.difficulty}
          </span>
          <span class="dur-badge">⏱ {lab.data.duration}</span>
          <span class="author-badge">by <a href={author.github} target="_blank" rel="noopener noreferrer">{author.name}</a></span>
        </div>
        <h1>{lab.data.title}</h1>
        <p class="description">{lab.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <AuthorCard author={lab.data.author} />
    </div>
  </article>

  </main>

  <Footer variant="sub" />
</Layout>

<style>
  .article {
    padding: 120px 2rem 100px;
    min-height: calc(100vh - 60px);
  }
  .container { max-width: 720px; margin: 0 auto; }
  .back-link {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-dim);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 34px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--cloud-color); }
  .article-header { margin-bottom: 56px; padding-bottom: 40px; border-bottom: 1px solid var(--border); }
  .lab-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .cloud-badge, .diff-badge, .dur-badge, .author-badge {
    font-family: var(--mono);
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 4px;
  }
  /* The cloud hue colours the text only (Thin Marker Rule); a tinted fill dropped it below 4.5:1. */
  .cloud-badge { color: var(--cloud-color); border: 1px solid var(--border); }
  .diff-badge[data-difficulty="beginner"] { color: var(--green-text); }
  .diff-badge[data-difficulty="intermediate"] { color: var(--accent); }
  .diff-badge[data-difficulty="advanced"] { color: var(--red-text); }
  .diff-badge { text-transform: capitalize; }
  .dur-badge, .author-badge { color: var(--text-dim); }
  .author-badge a { position: relative; color: var(--text-muted); text-decoration: none; }
  /* Small inline link; the invisible ::after gives it a 44px tap height. */
  .author-badge a::after { content: ''; position: absolute; inset: -14px -4px; }
  .author-badge a:hover { color: var(--accent); }
  .article-header h1 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.15;
    margin-bottom: 16px;
    color: var(--cloud-color);
  }
  .description {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .prose {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .prose :global(h2) { font-size: 24px; font-weight: 700; color: var(--text); margin: 48px 0 16px; letter-spacing: -0.5px; }
  .prose :global(h3) { font-size: 18px; font-weight: 700; color: var(--text); margin: 32px 0 12px; }
  .prose :global(p) { margin-bottom: 20px; }
  .prose :global(a) { color: var(--cloud-color); text-underline-offset: 3px; }
  .prose :global(:not(pre) > code) { font-family: var(--mono); font-size: 14px; background: var(--bg2); padding: 2px 6px; border-radius: 4px; }
  .prose :global(.code-block) { margin: 24px 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 24px; margin-bottom: 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(blockquote) { border-left: 3px solid var(--cloud-color); padding-left: 20px; color: var(--text-muted); margin: 24px 0; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
</style>
