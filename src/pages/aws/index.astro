<style>
  /* AWS-specific CSS vars additions */
  :root {
    --bar-track: rgba(255,255,255,0.05); --img-bar-track: rgba(255,255,255,0.04);
    --row-hover: rgba(255,255,255,0.02);
    --accent-glow: rgba(85,89,167,0.25);
  }
  html.light {
    --bar-track: rgba(0,0,0,0.06); --img-bar-track: rgba(0,0,0,0.05);
    --row-hover: rgba(0,0,0,0.02);
    --accent-glow: rgba(85,89,167,0.15);
  }

  /* HERO */
  .hero { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 160px 2rem 80px; position: relative; overflow: hidden; }
  .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(57,73,171,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(57,73,171,0.08) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black, transparent); }
  .hero-glow { position: absolute; width: 800px; height: 400px; background: radial-gradient(ellipse at center, rgba(85,89,167,0.14), transparent 70%); top: 20%; left: 50%; transform: translateX(-50%); pointer-events: none; }
  .badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(122,127,214,0.1); border: 1px solid rgba(122,127,214,0.28); border-radius: 100px; padding: 6px 16px; font-size: 12px; color: var(--accent); font-family: var(--mono); margin-bottom: 28px; animation: fadeSlideUp 0.6s ease both; max-width: 100%; }
  .badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-warm); animation: pulse 2s ease-in-out infinite; flex-shrink: 0; align-self: flex-start; margin-top: 4px; }
  @keyframes fadeSlideUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  .hero-logo-wrap { animation: fadeSlideUp 0.5s ease both; margin-bottom: 20px; }
  .hero-logo-svg { height: 72px; width: auto; animation: float 4s ease-in-out infinite; filter: drop-shadow(0 0 28px rgba(255,153,0,0.35)); }
  .hero-logo-svg .floci-text, .hero-logo-svg .floci-cloud { fill: #F8FAFC; }
  html.light .hero-logo-svg .floci-text { fill: #262425; }
  html.light .hero-logo-svg .floci-cloud { fill: #151515; }
  .hero-logo-svg .floci-dot.aws { fill: #FF9900; }
  .hero h1 { font-size: clamp(44px, 7vw, 88px); font-weight: 800; line-height: 1.05; letter-spacing: -2px; margin-bottom: 24px; animation: fadeSlideUp 0.6s 0.1s ease both; }
  .hero h1 .accent { color: #FF9900; }
  .hero h1 .strike { text-decoration: line-through; color: var(--text-dim); font-size: 0.75em; }
  .hero-sub { font-size: clamp(20px, 2vw, 24px); color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-weight: 300; animation: fadeSlideUp 0.6s 0.2s ease both; }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; animation: fadeSlideUp 0.6s 0.3s ease both; }
  #ghStarsBtn { font-family: var(--mono); font-size: 12px; background: rgba(0,0,0,0.15); border-radius: 4px; padding: 1px 7px; margin-left: 4px; }

  /* HERO STATS */
  .hero-stats { display: flex; gap: 0; margin-top: 70px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; animation: fadeSlideUp 0.6s 0.4s ease both; max-width: 860px; width: 100%; }
  .stat-item { flex: 1; padding: 24px 28px; border-right: 1px solid var(--border); background: var(--bg2); transition: background 0.2s; }
  .stat-item:last-child { border-right: none; }
  .stat-item:hover { background: var(--bg3); }
  @media (max-width: 640px) { .hero-stats { flex-wrap: wrap; } .stat-item { flex: 1 1 50%; border-right: none; border-bottom: 1px solid var(--border); padding: 18px 20px; } .stat-item:nth-child(odd) { border-right: 1px solid var(--border); } .stat-item:nth-last-child(-n+2) { border-bottom: none; } }
  .stat-number { font-family: var(--mono); font-size: 28px; font-weight: 700; color: var(--accent); display: block; margin-bottom: 4px; }
  .stat-label { font-size: 12px; color: var(--text-muted); }
  .stat-sub { font-size: 11px; color: var(--text-dim); margin-top: 2px; }

  /* MARQUEE */

  /* SELLING POINTS */
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-top: 60px; }
  .card { background: var(--bg2); padding: 36px 32px; transition: background 0.2s; position: relative; }
  .card:hover { background: var(--bg3); }
  .card-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 20px; }
  .card-icon.green { background: rgba(34,197,94,0.1); }
  .card-icon.amber { background: rgba(122,127,214,0.1); }
  .card-icon.blue { background: rgba(92,107,192,0.12); }
  .card-icon.teal { background: rgba(57,73,171,0.15); }
  .card h3 { font-size: 19px; font-weight: 700; margin-bottom: 10px; }
  .card p { font-size: 16px; color: var(--text-muted); line-height: 1.65; }

  /* PERFORMANCE */
  .perf-section { background: var(--bg2); }
  .perf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 60px; align-items: start; }
  @media(max-width: 768px) { .perf-grid { grid-template-columns: 1fr; } }
  .metric-card { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 28px; margin-bottom: 16px; }
  .metric-label { font-family: var(--mono); font-size: 12px; color: var(--text-muted); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px; }
  .metric-bars { display: flex; flex-direction: column; gap: 10px; }
  .bar-row { display: flex; flex-direction: column; gap: 5px; }
  .bar-row-header { display: flex; justify-content: space-between; font-size: 13px; }
  .bar-row-header .name { color: var(--text-muted); }
  .bar-row-header .val { font-family: var(--mono); color: var(--text); font-size: 12px; }
  .bar-track { height: 8px; background: var(--bar-track); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 4px; }
  .bar-fill.accent { background: var(--accent); }
  .bar-fill.red { background: rgba(239,68,68,0.7); }
  .win-badge { font-family: var(--mono); font-size: 11px; background: rgba(122,127,214,0.1); color: var(--accent); border: 1px solid rgba(122,127,214,0.28); border-radius: 4px; padding: 2px 8px; }
  .perf-callouts { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .callout { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 24px 20px; text-align: center; }
  .callout-num { font-family: var(--mono); font-size: 36px; font-weight: 700; color: var(--accent); display: block; line-height: 1; margin-bottom: 6px; }
  .callout-label { font-size: 13px; color: var(--text-muted); }
  .image-viz { padding: 20px 0; }
  .img-bar-row { margin-bottom: 14px; }
  .img-bar-label { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; }
  .img-bar-track { height: 12px; background: var(--img-bar-track); border-radius: 3px; overflow: hidden; }
  .img-bar-fill { height: 100%; border-radius: 3px; }
  .compat-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); gap: 12px; }
  .compat-row:last-child { border-bottom: none; }
  .compat-name { flex: 1; font-size: 13px; }
  .compat-bar { flex: 2; }
  .compat-score { font-family: var(--mono); font-size: 12px; min-width: 70px; text-align: right; }
  .compat-score.perfect { color: var(--accent); }
  .compat-bar-inner { height: 6px; border-radius: 3px; }

  /* SERVICES */
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-top: 60px; }
  .services-grid::after { content: ''; grid-column: auto / -1; background: var(--bg2); }
  .service-item { background: var(--bg2); padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 10px; row-gap: 3px; transition: background 0.15s; cursor: pointer; color: inherit; text-decoration: none; }
  .service-item:hover { background: var(--bg3); }
  .service-item.exclusive { background: var(--accent-dim); }
  .service-item.exclusive:hover { background: rgba(122,127,214,0.2); }
  .service-item.exclusive .service-icon { color: var(--accent); }
  .service-icon { width: 16px; height: 16px; color: var(--accent-warm); flex-shrink: 0; grid-column: 1; grid-row: 1; }
  .service-item:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .service-name { font-size: 13px; font-weight: 500; grid-column: 2; grid-row: 1; }
  .service-proto { font-family: var(--mono); font-size: 10px; color: var(--text-dim); grid-column: 2; grid-row: 2; white-space: normal; overflow-wrap: anywhere; }
  .docker-mark { display: inline-block; width: 9px; height: 9px; margin-left: 6px; vertical-align: baseline; }
  .docker-mark.default { fill: var(--text-dim); }
  .docker-mark.optional { fill: none; stroke: var(--text-dim); stroke-width: 2; }
  .grid-legend { display: flex; gap: 22px; justify-content: flex-end; flex-wrap: wrap; margin-top: 14px; font-size: 12px; color: var(--text-dim); }
  .grid-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .grid-legend svg { width: 10px; height: 10px; }

  /* IAM */
  .iam-section { background: var(--bg2); }
  .iam-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 60px; }
  @media(max-width: 768px) { .iam-cards { grid-template-columns: 1fr; } }
  .iam-card { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 32px 28px; position: relative; overflow: hidden; }
  .iam-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--accent-warm), var(--accent), transparent); }
  .iam-card-service { font-family: var(--mono); font-size: 11px; color: var(--accent); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; }
  .iam-card h3 { font-size: 22px; font-weight: 800; margin-bottom: 14px; }
  .iam-card p { font-size: 14px; color: var(--text-muted); margin-bottom: 20px; }
  .iam-features { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .iam-features li { font-size: 13px; color: var(--text-muted); display: flex; align-items: flex-start; gap: 10px; }
  .iam-features li::before { content: '✓'; color: var(--accent-warm); font-family: var(--mono); font-size: 12px; margin-top: 1px; flex-shrink: 0; }

  /* DOCKER ENGINES */
  .docker-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 60px; }
  .docker-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; padding: 32px; transition: transform 0.2s, border-color 0.2s; }
  .docker-card:hover { border-color: var(--accent); transform: translateY(-2px); }
