  .compare-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .compare-table th { padding: 14px 20px; text-align: left; border-bottom: 1px solid var(--border); font-weight: 600; color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; background: var(--bg2); }
