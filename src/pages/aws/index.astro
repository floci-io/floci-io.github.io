&nbsp;&nbsp;&nbsp;&nbsp;--name <span class="str">dev-cluster</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--role-arn arn:aws:iam::<span class="acc">000000000000</span>:role/eks-role \<br>
