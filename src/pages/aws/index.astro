  .quickstart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  @media(max-width: 768px) { .quickstart-grid { grid-template-columns: 1fr; } .migration-grid { grid-template-columns: 1fr !important; } }

  /* MIT BANNER */
