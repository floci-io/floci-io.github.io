---
import CloudPage from '../../layouts/CloudPage.astro';
import { AWS_SERVICES } from '../../data/cloud-services';
import { SERVICE_COUNTS } from '../../data/services';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "floci",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "license": "https://opensource.org/licenses/MIT",
  "url": "https://floci.io/aws/",
  "downloadUrl": "https://github.com/floci-io/floci",
  "description": `Fast, free AWS emulator. ${SERVICE_COUNTS.aws} services, 24 ms startup, drop-in LocalStack replacement.`,
  "keywords": "AWS emulator, LocalStack alternative, local cloud, S3 mock, DynamoDB local"
};
---

<CloudPage
  cloud="aws"
  title="floci: Fast, Free AWS Emulator"
  description="floci is a fast, free, open-source AWS emulator built with Quarkus Native. Starts in 24 ms, uses ~13 MiB at idle. Drop-in replacement for LocalStack. No auth token, no restrictions, ever."
  canonical="https://floci.io/aws/"
  ogImage="https://floci.io/og/aws.png"
  jsonLd={jsonLd}
  docsHref="/floci/"
  services={AWS_SERVICES}
  servicesDesc="Every service is fully unlocked. Related APIs share a chip, such as DynamoDB + Streams."
  migrateLabel="From LocalStack"
>
  <section slot="quickstart" class="quickstart-section" id="quickstart">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Quick Start</div>
        <h2>Every way to run it.</h2>
        <p class="section-desc">One CLI installs and runs all four emulators: use Homebrew, the install script or PowerShell. Or skip the CLI and run the Docker image.</p>
      </div>

      <!-- method tabs -->
      <div class="qs-method-tabs reveal reveal-delay-sm" id="qsMethodTabs">
        <button class="qs-method-tab active" data-qs="cli">floci CLI</button>
        <button class="qs-method-tab" data-qs="docker">Docker</button>
      </div>

      <!-- floci CLI panel -->
      <div id="qspanel-cli" class="qs-panel reveal reveal-delay">
        <div class="quickstart-grid">
          <div>
            <h3 class="qs-step">1 · Install floci CLI</h3>
            <div class="code-tabs" id="installTabs">
              <button class="code-tab active" data-tab="brew">Homebrew</button>
              <button class="code-tab" data-tab="curl">curl</button>
              <button class="code-tab" data-tab="ps">PowerShell</button>
            </div>
            <div id="itab-brew" class="code-block tabbed" data-lang="bash"><pre
><span class="cmd">brew install <span class="acc">floci-io/floci/floci</span></span></pre></div>
            <div id="itab-curl" class="code-block tabbed" style="display:none" data-lang="bash"><pre
><span class="cmd">curl -fsSL <span class="acc">https://floci.io/install.sh</span> | sh</span></pre></div>
            <div id="itab-ps" class="code-block tabbed" style="display:none" data-lang="bash"><pre
><span class="cmd">iwr <span class="acc">https://floci.io/install.ps1</span> | iex</span></pre></div>

            <h3 class="qs-step">2 · Start the emulator</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci start</span></pre></div>

            <h3 class="qs-step">3 · Export env vars</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">eval $(floci env)</span>
<span class="comment"># exports AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID,</span>
<span class="comment"># AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION</span></pre></div>

            <h3 class="qs-step">4 · Upload a file</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Create a bucket</span>
<span class="cmd">aws s3 mb s3://<span class="str">my-bucket</span></span>

<span class="comment"># Write a file and upload it</span>
<span class="cmd">echo <span class="str">"Why pay for S3 when floci is free?"</span> &gt; hello-floci.txt
aws s3 cp hello-floci.txt \
  s3://<span class="str">my-bucket</span>/hello-floci.txt</span>

<span class="comment"># Download it back and read it</span>
<span class="cmd">aws s3 cp s3://<span class="str">my-bucket</span>/hello-floci.txt \
  hello-back.txt
cat hello-back.txt</span></pre></div>
          </div>

          <div>
            <h3 class="qs-step">Teach your coding agent</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Asks which agents to install it for</span>
<span class="cmd">npx skills add <span class="acc">floci-io/floci-cli</span></span></pre></div>
            <p class="qs-note">The Floci skill teaches Claude Code, Codex, Cursor, Kiro and other coding agents to run the emulators with floci-cli.</p>

            <h3 class="qs-step">Other useful commands</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Check status</span>
<span class="cmd">floci status</span>

<span class="comment"># View logs</span>
<span class="cmd">floci logs --follow</span>

<span class="comment"># Stop the emulator</span>
<span class="cmd">floci stop</span>

<span class="comment"># Run health diagnostics</span>
<span class="cmd">floci doctor</span></pre></div>

            <h3 class="qs-step">Start with persistence</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci start --persist <span class="acc">./data</span></span>
<span class="comment"># state survives container restarts</span></pre></div>

            <h3 class="qs-step">Save &amp; restore state</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci snapshot save <span class="acc">my-snapshot</span></span>
<span class="cmd">floci snapshot load <span class="acc">my-snapshot</span></span></pre></div>
          </div>
        </div>
      </div>

      <!-- Docker panel -->
      <div id="qspanel-docker" class="qs-panel reveal reveal-delay" style="display:none">
        <div class="quickstart-grid">
          <div>
            <h3 class="qs-step">docker run</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># All {SERVICE_COUNTS.aws} services on :4566</span>
<span class="cmd">docker run -d --name floci \
  -p <span class="acc">4566:4566</span> \
  -v /var/run/docker.sock:/var/run/docker.sock \
  floci/floci:<span class="acc">latest</span></span></pre></div>

            <h3 class="qs-step">Set env vars</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">export <span class="acc">AWS_ENDPOINT_URL</span>=http://localhost:4566
export <span class="acc">AWS_ACCESS_KEY_ID</span>=test
export <span class="acc">AWS_SECRET_ACCESS_KEY</span>=test
export <span class="acc">AWS_DEFAULT_REGION</span>=us-east-1</span></pre></div>

            <h3 class="qs-step">Upload a file</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">aws s3 mb s3://<span class="str">my-bucket</span>
echo <span class="str">"Why pay for S3 when floci is free?"</span> \
  &gt; hello-floci.txt
aws s3 cp hello-floci.txt \
  s3://<span class="str">my-bucket</span>/hello-floci.txt
aws s3 cp s3://<span class="str">my-bucket</span>/hello-floci.txt \
  hello-back.txt
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 class="qs-step">docker-compose</h3>
            <div class="code-block" data-lang="yaml"><pre
><span class="cmd">services:
  floci:
    image: floci/floci:<span class="acc">latest</span>
    ports:
      - <span class="str">"4566:4566"</span>
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./data:/app/data
    environment:
      FLOCI_STORAGE_MODE: <span class="acc">hybrid</span></span></pre></div>

            <h3 class="qs-step">Java SDK v2</h3>
            <div class="code-block" data-lang="java"><pre
><span class="cmd">S3Client s3 = S3Client.builder()
  .endpointOverride(URI.create(<span class="str">"http://localhost:4566"</span>))
  .region(Region.<span class="acc">US_EAST_1</span>)
  .credentialsProvider(
    StaticCredentialsProvider.create(
      AwsBasicCredentials.create(<span class="str">"test"</span>, <span class="str">"test"</span>)))
  .build();</span></pre></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section slot="examples" id="examples">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Examples</div>
        <h2>Recipes that span several services.</h2>
        <p class="section-desc">End-to-end recipes for complex services. No cloud account needed.</p>
      </div>
      <div class="reveal reveal-delay examples-body">
        <div class="code-tabs" id="exampleTabs">
          <button class="code-tab active" data-tab="eks">EKS + kubectl</button>
          <button class="code-tab" data-tab="ecs">ECS Tasks</button>
          <button class="code-tab" data-tab="athena">Athena + S3</button>
        </div>
        <div id="tab-eks" class="code-block tabbed" data-lang="bash">
          <span class="comment"># Set up environment</span><br>
          <span class="cmd">export <span class="acc">AWS_ENDPOINT_URL</span>=<span class="str">http://localhost:4566</span><br>
export <span class="acc">AWS_DEFAULT_REGION</span>=<span class="str">us-east-1</span><br>
export <span class="acc">AWS_ACCESS_KEY_ID</span>=<span class="str">test</span><br>
export <span class="acc">AWS_SECRET_ACCESS_KEY</span>=<span class="str">test</span></span><br><br>
          <span class="comment"># Create EKS cluster (Floci spins up a real k3s node)</span><br>
          <span class="cmd">aws eks create-cluster \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--name <span class="str">dev-cluster</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--role-arn arn:aws:iam::<span class="acc">000000000000</span>:role/eks-role \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--resources-vpc-config subnetIds=<span class="str">subnet-default-us-east-1-a</span></span><br><br>
          <span class="comment"># Pull kubeconfig and use kubectl</span><br>
          <span class="cmd">aws eks wait cluster-active --name <span class="str">dev-cluster</span></span><br><br>
          <span class="comment"># kubectl needs a real IAM key: floci rejects test/test for cluster-admin</span><br>
          <span class="cmd">aws iam create-user --user-name <span class="str">eks-admin</span><br>
read <span class="acc">AWS_ACCESS_KEY_ID</span> <span class="acc">AWS_SECRET_ACCESS_KEY</span> &lt;&lt;&lt; "$(aws iam create-access-key \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--user-name <span class="str">eks-admin</span> --query <span class="str">'AccessKey.[AccessKeyId,SecretAccessKey]'</span> --output text)"<br>
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY<br><br>
aws eks update-kubeconfig --name <span class="str">dev-cluster</span><br>
kubectl run nginx --image=<span class="str">nginx:alpine</span> --port=<span class="acc">80</span><br>
kubectl get pods,svc</span>
        </div>
        <div id="tab-ecs" class="code-block tabbed" style="display:none" data-lang="bash">
          <span class="comment"># Set up environment</span><br>
          <span class="cmd">export <span class="acc">AWS_ENDPOINT_URL</span>=<span class="str">http://localhost:4566</span></span><br><br>
          <span class="comment"># Register task definition and create cluster</span><br>
          <span class="cmd">aws ecs register-task-definition \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--family <span class="str">web-task</span> --network-mode <span class="str">bridge</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--container-definitions <span class="str">'[&#123;"name":"web","image":"nginx:alpine","portMappings":[&#123;"containerPort":80,"hostPort":8081&#125;],"memory":128,"cpu":64&#125;]'</span><br><br>
aws ecs create-cluster --cluster-name <span class="str">dev-cluster</span></span><br><br>
          <span class="comment"># Run a task (Floci launches a real Docker container)</span><br>
          <span class="cmd">aws ecs run-task \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--cluster <span class="str">dev-cluster</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--task-definition <span class="str">web-task</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--count 1</span>
        </div>
        <div id="tab-athena" class="code-block tabbed" style="display:none" data-lang="bash">
          <span class="comment"># Point the AWS CLI at floci</span><br>
          <span class="cmd">export <span class="acc">AWS_ENDPOINT_URL</span>=<span class="str">http://localhost:4566</span><br>
export <span class="acc">AWS_DEFAULT_REGION</span>=<span class="str">us-east-1</span><br>
export <span class="acc">AWS_ACCESS_KEY_ID</span>=<span class="str">test</span><br>
export <span class="acc">AWS_SECRET_ACCESS_KEY</span>=<span class="str">test</span></span><br><br>
          <span class="comment"># Sample data: one JSON object per line</span><br>
          <span class="cmd">printf <span class="str">'&#123;"customer":"ana","amount":12.5&#125;\n&#123;"customer":"ben","amount":8&#125;\n&#123;"customer":"ana","amount":4&#125;\n'</span> &gt; orders.json<br>
aws s3 mb s3://<span class="str">analytics-bucket</span><br>
aws s3 cp orders.json s3://<span class="str">analytics-bucket</span>/orders/</span><br><br>
          <span class="comment"># Register a Glue database and a JSON table over the data</span><br>
          <span class="cmd">aws glue create-database --database-input <span class="str">'&#123;"Name":"shop"&#125;'</span><br>
aws glue create-table --database-name <span class="str">shop</span> --table-input <span class="str">'&#123;"Name":"orders","TableType":"EXTERNAL_TABLE","StorageDescriptor":&#123;"Location":"s3://analytics-bucket/orders/","InputFormat":"org.apache.hadoop.mapred.TextInputFormat","OutputFormat":"org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat","SerdeInfo":&#123;"SerializationLibrary":"org.openx.data.jsonserde.JsonSerDe"&#125;,"Columns":[&#123;"Name":"customer","Type":"string"&#125;,&#123;"Name":"amount","Type":"double"&#125;]&#125;&#125;'</span></span><br><br>
          <span class="comment"># Run the query, wait for it, read the results</span><br>
          <span class="cmd">QUERY_ID=$(aws athena start-query-execution \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--query-string <span class="str">"SELECT customer, SUM(amount) FROM shop.orders GROUP BY customer"</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--result-configuration <span class="str">'&#123;"OutputLocation":"s3://analytics-bucket/results/"&#125;'</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--query <span class="str">'QueryExecutionId'</span> --output text)<br>
while [ -n "$QUERY_ID" ]; do<br>
&nbsp;&nbsp;STATE=$(aws athena get-query-execution --query-execution-id <span class="acc">$QUERY_ID</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--query <span class="str">'QueryExecution.Status.State'</span> --output text)<br>
&nbsp;&nbsp;case $STATE in SUCCEEDED) break ;; FAILED|CANCELLED) echo <span class="str">"Query $STATE"</span>; break ;; esac<br>
&nbsp;&nbsp;sleep 1<br>
done<br>
aws athena get-query-results --query-execution-id <span class="acc">$QUERY_ID</span></span>
        </div>
      </div>

    </div>
  </section>

  <section slot="why" id="why">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Why floci</div>
        <h2>Same calls, same port, no lock-in.</h2>
        <p class="section-desc">Point the AWS SDK at port 4566 and keep your code. Everything below is in the free, MIT-licensed build.</p>
      </div>
      <div class="hairline reveal reveal-delay"><div class="hairline-grid cols-4">
        <div><h3>Truly MIT licensed</h3><p>Fork it, embed it, extend it. No "community edition" sunset. No "enterprise" feature flags. Every service available to every developer, always.</p></div>
        <div><h3>Drop-in compatible</h3><p>Same port 4566, same wire protocols, same AWS SDK calls. Point the endpoint at Floci and your application code stays as it is.</p></div>
        <div><h3>Optional TLS / HTTPS</h3><p>Enable HTTPS with one env var. Floci auto-generates a self-signed certificate at startup so you can test TLS-sensitive code paths locally.</p></div>
        <div><h3>Per-account isolation</h3><p>Full multi-tenancy: each AWS account ID gets its own isolated storage. Run dev, staging, and test on a single Floci instance.</p></div>
      </div></div>
      <div class="why-engines">
      <div class="reveal">
        <div class="section-label">Real engines</div>
        <h2>Real engines, real IAM, on your laptop.</h2>
        <p class="section-desc">Floci doesn't mock responses. For complex data services it runs the real engine in Docker and speaks its wire protocol, and Lambda, ElastiCache, RDS, ECS, EC2, MSK, EKS, OpenSearch, ECR and CodeBuild all authenticate with real IAM and SigV4.</p>
      </div>
      <div class="hairline reveal reveal-delay"><div class="hairline-grid cols-3">
        <div><h3>Lambda Runtimes</h3><p>Execution in isolated Docker containers using real AWS runtimes. Node.js, Python, Java, Go, and more with identical environment variables.</p></div>
        <div><h3>RDS Engines</h3><p>Real PostgreSQL, MySQL, or MariaDB instances. Full lifecycle, snapshot/restore, and JDBC traffic with IAM database authentication.</p></div>
        <div><h3>ElastiCache (Redis)</h3><p>Real Redis container. Floci acts as a SigV4 proxy for IAM authentication against your local Redis cluster.</p></div>
        <div><h3>Amazon ECS</h3><p>Orchestrates real Docker containers for task definitions, providing a local control plane for task lifecycle management.</p></div>
        <div><h3>OpenSearch</h3><p>Real OpenSearch clusters. Floci manages the underlying engine nodes, fully functional with the complete OpenSearch API suite.</p></div>
        <div><h3>MSK (Kafka)</h3><p>Real Apache Kafka via Redpanda. Perfect for testing event-driven architectures with the same performance and semantics as Amazon MSK.</p></div>
        <div><h3>ECR Registry</h3><p>Real OCI-compatible registry (<code class="inline-code">registry:2</code>). Push and pull with the stock Docker client, including image-backed Lambdas.</p></div>
        <div><h3>Athena</h3><p>Query execution in a DuckDB sidecar container. Same execution model as AWS Athena, no mocking.</p></div>
        <div><h3>EC2 Instances</h3><p>RunInstances launches real Docker containers. SSH key injection, UserData execution, and IMDS (IMDSv1 + IMDSv2) with IAM credential serving.</p></div>
      </div></div>
      </div>
    </div>
  </section>

  <section slot="migrate" id="migrate">
    <div class="container">
      <div class="reveal">
        <div class="section-label">From LocalStack</div>
        <h2>Switching from LocalStack?</h2>
        <p class="section-desc">Same port, same credentials, same SDK endpoint override and CLI flags. Swap the image and keep going: 138× faster startup and 91% less memory.</p>
      </div>
      <div class="migrate-strings reveal reveal-delay">
        <div class="code-block" data-lang="docker-compose.yml"><pre
><span class="comment"># Before</span>
<span class="cmd">image: localstack/localstack</span>

<span class="comment"># After</span>
<span class="cmd">image: floci/floci:<span class="acc">latest</span></span>

<span class="comment"># After, if init scripts need the AWS CLI or boto3</span>
<span class="cmd">image: floci/floci:<span class="acc">latest-compat</span></span></pre></div>
      </div>
      <div class="reveal migrate-table">
        <h3 class="table-title">LocalStack settings, translated automatically</h3>
        <p class="table-intro">Init scripts under <code>/etc/localstack/init/</code> run unchanged, and <code>/_localstack/health</code> is still served. Set <code>LOCALSTACK_PARITY=false</code> to opt out of the translation.</p>
        <div class="conn-wrap">
          <table class="conn-table">
            <thead><tr><th>LocalStack</th><th>Floci</th></tr></thead>
            <tbody>
              <tr><td><code>LOCALSTACK_HOST</code></td><td><code>FLOCI_HOSTNAME</code></td></tr>
              <tr><td><code>PERSISTENCE=1</code></td><td><code>FLOCI_STORAGE_MODE=persistent</code></td></tr>
              <tr><td><code>LAMBDA_DOCKER_NETWORK</code></td><td><code>FLOCI_SERVICES_LAMBDA_DOCKER_NETWORK</code></td></tr>
              <tr><td><code>LAMBDA_REMOVE_CONTAINERS=1</code></td><td><code>FLOCI_SERVICES_LAMBDA_EPHEMERAL=true</code></td></tr>
              <tr><td><code>DEBUG=1</code></td><td><code>QUARKUS_LOG_LEVEL=DEBUG</code></td></tr>
            </tbody>
          </table>
        </div>
        <p class="migrate-more"><a href="/aws/compare/">Feature table, benchmarks and the full migration guide</a></p>
      </div>
    </div>
  </section>
</CloudPage>

<style>

  /* PERFORMANCE */
  /* Hairline-grid content: engine tags, inline code and the IAM checklists. */
  .inline-code { font-family: var(--mono); font-size: 13px; color: var(--accent); }
  /* Inline prose link: padding gives it a 44px tap height without moving the text. */

  /* CODE */
  .qs-method-tabs { display: flex; gap: 4px; margin-top: 40px; border-bottom: 1px solid var(--border); }
  .qs-method-tab { min-height: 44px; padding: 10px 22px; font-size: 13px; font-family: var(--mono); color: var(--text-muted); background: transparent; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; margin-bottom: -1px; }
  .qs-method-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .qs-method-tab:hover:not(.active) { color: var(--text); }
  .qs-panel { margin-top: 36px; }
  .quickstart-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  @media(max-width: 768px) { .quickstart-grid { grid-template-columns: minmax(0, 1fr); } }
  /* Closing call to action: open, centred, marked by a short line in the AWS hue (as on the other cloud pages). */

  /* Why: the real-engines block follows the feature grid. */
  .why-engines { margin-top: 80px; }
  @media (max-width: 600px) { .why-engines { margin-top: 56px; } }
</style>

<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));


document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});

document.querySelectorAll('#installTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#installTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('itab-' + tab.getAttribute('data-tab'));
    if (target) target.style.display = 'block';
  });
});

document.querySelectorAll('#exampleTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#exampleTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="tab-"]').forEach(function(p) { p.style.display = 'none'; });
    const tabKey = tab.getAttribute('data-tab');
    const target = document.getElementById('tab-' + tabKey);
    if (target) target.style.display = 'block';
  });
});

</script>
