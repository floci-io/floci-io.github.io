          <span class="cmd">aws ecs register-task-definition \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--family <span class="str">web-task</span> --network-mode <span class="str">bridge</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--container-definitions <span class="str">'[&#123;"name":"web","image":"nginx:alpine","portMappings":[&#123;"containerPort":80,"hostPort":8081&#125;],"memory":128,"cpu":64&#125;]'</span><br><br>
aws ecs create-cluster --cluster-name <span class="str">dev-cluster</span></span><br><br>
          <span class="comment"># Run a task (Floci launches a real Docker container)</span><br>
          <span class="cmd">aws ecs run-task \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--cluster <span class="str">dev-cluster</span> \<br>
&nbsp;&nbsp;&nbsp;&nbsp;--task-definition <span class="str">web-task</span> \<br>
