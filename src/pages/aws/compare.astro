  .code-block pre { margin: 0; padding: 0; font: inherit; color: inherit; white-space: pre; background: none; border: none; overflow: visible; line-height: inherit; }
  .code-block .comment { color: var(--text-dim); }
  .code-block .cmd { color: var(--text); }
  .code-block .acc { color: var(--accent); }
  .code-block .str { color: #f97316; }
</style>

<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

fetch('https://api.github.com/repos/floci-io/floci').then(r => r.json()).then(data => {
  const count = data.stargazers_count;
  if (!count) return;
  const fmt = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : count;
  const nav = document.getElementById('ghNavStars');
  if (nav) nav.textContent = ' · ' + fmt;
}).catch(() => {});
</script>
