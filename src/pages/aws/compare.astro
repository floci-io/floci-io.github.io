  .bar-row-header { display: flex; justify-content: space-between; font-size: 13px; }
  .bar-row-header .name { color: var(--text-muted); }
  .bar-row-header .val { font-family: var(--mono); color: var(--text); font-size: 12px; }
  .bar-track { height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 4px; transition: width 1s cubic-bezier(0.4,0,0.2,1); }
  .bar-fill.bar-accent { background: var(--accent); }
  .bar-fill.bar-red { background: rgba(239,68,68,0.7); }
  .win-badge { font-family: var(--mono); font-size: 11px; background: rgba(122,127,214,0.1); color: var(--accent); border: 1px solid rgba(122,127,214,0.28); border-radius: 4px; padding: 2px 8px; }
  .perf-callouts { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .callout { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 24px 20px; text-align: center; }
  .callout-num { font-family: var(--mono); font-size: 36px; font-weight: 700; color: var(--accent); display: block; line-height: 1; margin-bottom: 6px; }
  .callout-label { font-size: 13px; color: var(--text-muted); }
  .image-viz { padding: 20px 0; }
  .img-bar-row { margin-bottom: 14px; }
  .img-bar-label { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; }
  .img-bar-track { height: 12px; background: rgba(255,255,255,0.04); border-radius: 3px; overflow: hidden; }
