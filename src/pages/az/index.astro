---
import CloudPage from '../../layouts/CloudPage.astro';
import { AZURE_SERVICES } from '../../data/cloud-services';
import { SERVICE_COUNTS } from '../../data/services';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "floci-az",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux, macOS, Windows",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "license": "https://opensource.org/licenses/MIT",
  "url": "https://floci.io/az/",
  "downloadUrl": "https://github.com/floci-io/floci-az",
  "description": "Free Azure emulator. Blob Storage, Queue, Functions, Key Vault, Cosmos DB and more on a single port. No Azure account required.",
  "keywords": "Azure emulator, Azurite alternative, local Azure, Blob Storage mock, Cosmos DB local"
};
---

<CloudPage
  cloud="azure"
  title="floci-az: Free Azure Emulator"
  description="floci-az is a fast, free, open-source Azure emulator. Blob, Queue, Table, Functions, App Config, Key Vault, Event Hubs, Service Bus, Cosmos DB, AKS, Azure SQL, API Management, Virtual Machines, Cache for Redis, Container Registry, Virtual Network, Azure Monitor, Microsoft Entra ID, and Email Communication on a single port. No Azure account required, MIT licensed."
  canonical="https://floci.io/az/"
  ogImage="https://floci.io/og/az.png"
  jsonLd={jsonLd}
  docsHref="/floci-az/"
  services={AZURE_SERVICES}
  migrateLabel="From Azurite"
  servicesDesc="Wire-compatible with the official Azure SDKs and the Azurite emulator. Switch by changing the endpoint; your application code stays as it is."
>
  <section slot="quickstart" id="quickstart">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Quick Start</div>
        <h2>Every way to run it.</h2>
        <p class="section-desc">One CLI installs and runs all four emulators: use Homebrew, the install script or PowerShell. Or skip the CLI and run the Docker image.</p>
      </div>

      <!-- method tabs -->
      <div class="qs-method-tabs reveal reveal-delay-sm" id="qsMethodTabs">
        <button class="qs-method-tab active" data-qs="cli">floci CLI</button>
        <button class="qs-method-tab" data-qs="docker">Docker</button>
      </div>

      <!-- floci CLI panel -->
      <div id="qspanel-cli" class="qs-panel reveal reveal-delay">
        <div class="qs-grid">
          <div>
            <h3 class="qs-step">1 · Install floci CLI</h3>
            <div class="code-tabs" id="installTabs">
              <button class="code-tab active" data-tab="brew">Homebrew</button>
              <button class="code-tab" data-tab="curl">curl</button>
              <button class="code-tab" data-tab="ps">PowerShell</button>
            </div>
            <div id="itab-brew" class="code-block tabbed" data-lang="bash"><pre
><span class="cmd">brew install <span class="acc">floci-io/floci/floci</span></span></pre></div>
            <div id="itab-curl" class="code-block tabbed" style="display:none" data-lang="bash"><pre
><span class="cmd">curl -fsSL <span class="acc">https://floci.io/install.sh</span> | sh</span></pre></div>
            <div id="itab-ps" class="code-block tabbed" style="display:none" data-lang="bash"><pre
><span class="cmd">iwr <span class="acc">https://floci.io/install.ps1</span> | iex</span></pre></div>

            <h3 class="qs-step">2 · Start the emulator</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci az start</span></pre></div>

            <h3 class="qs-step">3 · Export env vars</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">eval $(floci az env)</span>
<span class="comment"># exports AZURE_STORAGE_CONNECTION_STRING</span></pre></div>

            <h3 class="qs-step">4 · Upload a file</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Create a container</span>
<span class="cmd">az storage container create \
  --name <span class="str">my-container</span> \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span></span>

<span class="comment"># Write a file and upload it</span>
<span class="cmd">echo <span class="str">"Azure locally: no bill, no drama."</span> \
  &gt; hello-floci.txt
az storage blob upload \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-floci.txt \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span></span>

<span class="comment"># Download it back and read it</span>
<span class="cmd">az storage blob download \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-back.txt \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span>
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 class="qs-step">Teach your coding agent</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Asks which agents to install it for</span>
<span class="cmd">npx skills add <span class="acc">floci-io/floci-cli</span></span></pre></div>
            <p class="qs-note">The Floci skill teaches Claude Code, Codex, Cursor, Kiro and other coding agents to run the emulators with floci-cli.</p>

            <h3 class="qs-step">Other useful commands</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># Check status</span>
<span class="cmd">floci az status</span>

<span class="comment"># View logs</span>
<span class="cmd">floci az logs</span>

<span class="comment"># Stop the emulator</span>
<span class="cmd">floci az stop</span>

<span class="comment"># Print individual SDK endpoint vars</span>
<span class="cmd">eval $(floci az env --format sdk-vars)</span>
<span class="comment"># exports AZURE_STORAGE_BLOB_ENDPOINT,</span>
<span class="comment"># AZURE_APP_CONFIGURATION_ENDPOINT,</span>
<span class="comment"># AZURE_KEY_VAULT_ENDPOINT, ...</span></pre></div>

            <h3 class="qs-step">Start with persistence</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci az start --persist <span class="acc">./data</span></span>
<span class="comment"># state survives container restarts</span></pre></div>

            <h3 class="qs-step">Diagnose issues</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">floci az doctor</span>
<span class="comment"># checks Docker, Azure CLI, connectivity</span></pre></div>
          </div>
        </div>
      </div>

      <!-- Docker panel -->
      <div id="qspanel-docker" class="qs-panel reveal reveal-delay" style="display:none">
        <div class="qs-grid">
          <div>
            <h3 class="qs-step">Docker</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="comment"># REST :4577 · AMQP :5672/:5673 · the socket lets Functions, Cosmos DB, SQL and more run containers</span>
<span class="cmd">docker run -d --name floci-az \
  -p <span class="acc">4577:4577</span> \
  -p <span class="acc">5672:5672</span> \
  -p <span class="acc">5673:5673</span> \
  -v /var/run/docker.sock:/var/run/docker.sock \
  floci/floci-az:<span class="acc">latest</span></span></pre></div>

            <h3 class="qs-step">docker-compose</h3>
            <div class="code-block" data-lang="yaml"><pre
><span class="cmd">services:
  floci-az:
    image: floci/floci-az:<span class="acc">latest</span>
    ports:
      - <span class="str">"4577:4577"</span>
      - <span class="str">"5672:5672"</span>
      - <span class="str">"5673:5673"</span>
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock</span></pre></div>

            <h3 class="qs-step">Upload a file</h3>
            <div class="code-block" data-lang="bash"><pre
><span class="cmd">export <span class="acc">AZURE_STORAGE_CONNECTION_STRING</span>="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:4577/devstoreaccount1;QueueEndpoint=http://localhost:4577/devstoreaccount1-queue;TableEndpoint=http://localhost:4577/devstoreaccount1-table;"</span>

<span class="cmd">az storage container create \
  --name <span class="str">my-container</span> \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span>
echo <span class="str">"Azure locally: no bill, no drama."</span> \
  &gt; hello-floci.txt
az storage blob upload \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-floci.txt \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span>
az storage blob download \
  --container-name <span class="str">my-container</span> \
  --name <span class="str">hello-floci.txt</span> \
  --file hello-back.txt \
  --connection-string <span class="acc">$AZURE_STORAGE_CONNECTION_STRING</span>
cat hello-back.txt</span></pre></div>
          </div>
          <div>
            <h3 class="qs-step">Connection string</h3>
            <p class="qs-note conn-note">The standard Azurite-compatible string, with Queue and Table on their own paths.</p>
            <div class="code-block conn-string" data-lang="connection string"><pre>DefaultEndpointsProtocol=http;AccountName=<span class="acc">devstoreaccount1</span>;AccountKey=<span class="acc">Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==</span>;BlobEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;QueueEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1-queue;TableEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1-table;</pre></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section slot="examples" id="examples">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Examples</div>
        <h2>One blob upload, four SDKs.</h2>
        <p class="section-desc">Each sample reads <code>AZURE_STORAGE_CONNECTION_STRING</code>, which <code>eval $(floci az env)</code> sets. On the Docker path, export it from the Quick Start.</p>
      </div>
      <div class="reveal reveal-delay examples-body">
        <div class="code-tabs" id="sdkTabs">
          <button class="code-tab active" data-tab="python">Python</button>
          <button class="code-tab" data-tab="java">Java</button>
          <button class="code-tab" data-tab="dotnet">.NET</button>
          <button class="code-tab" data-tab="js">JavaScript</button>
        </div>

        <div id="stab-python" class="code-block tabbed" data-lang="python">
          <span class="comment"># pip install azure-storage-blob</span><br>
          <span class="cmd">import os<br>
from azure.storage.blob import BlobServiceClient<br><br>
client = BlobServiceClient.from_connection_string(<br>
&nbsp;&nbsp;&nbsp;&nbsp;os.environ[<span class="str">"AZURE_STORAGE_CONNECTION_STRING"</span>])<br>
container = client.get_container_client(<span class="str">"my-container"</span>)<br>
if not container.exists():<br>
&nbsp;&nbsp;&nbsp;&nbsp;container.create_container()<br><br>
blob = container.get_blob_client(<span class="str">"hello.txt"</span>)<br>
blob.upload_blob(<span class="str">b"Hello from floci-az!"</span>, overwrite=True)</span>
        </div>

        <div id="stab-java" class="code-block tabbed" style="display:none" data-lang="java">
          <span class="comment">// azure-storage-blob:12.x</span><br>
          <span class="cmd">BlobServiceClient client = new BlobServiceClientBuilder()<br>
&nbsp;&nbsp;.connectionString(System.getenv(<span class="str">"AZURE_STORAGE_CONNECTION_STRING"</span>))<br>
&nbsp;&nbsp;.buildClient();<br><br>
BlobContainerClient container = client.getBlobContainerClient(<span class="str">"my-container"</span>);<br>
container.createIfNotExists();<br>
BlobClient blob = container.getBlobClient(<span class="str">"hello.txt"</span>);<br>
blob.upload(BinaryData.fromString(<span class="str">"Hello from floci-az!"</span>), true);</span>
        </div>

        <div id="stab-dotnet" class="code-block tabbed" style="display:none" data-lang="csharp">
          <span class="comment">// Azure.Storage.Blobs NuGet package</span><br>
          <span class="cmd">var client = new BlobServiceClient(<br>
&nbsp;&nbsp;Environment.GetEnvironmentVariable(<span class="str">"AZURE_STORAGE_CONNECTION_STRING"</span>));<br>
var container = client.GetBlobContainerClient(<span class="str">"my-container"</span>);<br>
await container.CreateIfNotExistsAsync();<br><br>
var blob = container.GetBlobClient(<span class="str">"hello.txt"</span>);<br>
await blob.UploadAsync(BinaryData.FromString(<span class="str">"Hello from floci-az!"</span>), overwrite: true);</span>
        </div>

        <div id="stab-js" class="code-block tabbed" style="display:none" data-lang="javascript">
          <span class="comment">// npm install @azure/storage-blob</span><br>
          <span class="cmd">import { "{"} BlobServiceClient {"}"} from <span class="str">"@azure/storage-blob"</span>;<br><br>
const client = BlobServiceClient.fromConnectionString(<br>
&nbsp;&nbsp;process.env.AZURE_STORAGE_CONNECTION_STRING);<br>
const container = client.getContainerClient(<span class="str">"my-container"</span>);<br>
await container.createIfNotExists();<br><br>
const blob = container.getBlockBlobClient(<span class="str">"hello.txt"</span>);<br>
await blob.upload(<span class="str">"Hello from floci-az!"</span>, 20);</span>
        </div>
      </div>

    </div>
  </section>

  <section slot="why" id="why">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Why floci-az</div>
        <h2>Azurite's connection string, and the rest of Azure.</h2>
        <p class="section-desc">Blob, Queue and Table answer the way Azurite does, next to Event Hubs, Service Bus, Cosmos DB, Key Vault and more on port 4577.</p>
      </div>
      <div class="hairline reveal reveal-delay"><div class="hairline-grid cols-4">
        <div><h3>More than Azurite</h3><p>Azurite covers Blob, Queue and Table. floci-az serves those with the same account name and key, plus {SERVICE_COUNTS.azure - 3} more services.</p></div>
        <div><h3>AMQP for native clients</h3><p>Event Hubs and Service Bus also listen on AMQP ports 5672 and 5673, so native SDK clients connect without a proxy layer.</p></div>
        <div><h3>Real database engines</h3><p>Azure SQL and the PostgreSQL, MySQL and MariaDB flexible servers run the real engines in Docker containers.</p></div>
        <div><h3>Native binary speed</h3><p>Starts in 24 ms and idles at ~13 MiB, fast enough to start a fresh emulator for every test run.</p></div>
      </div></div>
    </div>
  </section>
  <section slot="migrate" id="migrate">
    <div class="container">
      <div class="reveal">
        <div class="section-label">From Azurite</div>
        <h2>Switching from Azurite?</h2>
        <p class="section-desc">Keep the account name, the key and the connection string format. Point the endpoints at port 4577 instead of Azurite's 10000, 10001 and 10002, and Queue and Table move to their own paths on the same port.</p>
      </div>
      <div class="migrate-strings reveal reveal-delay">
        <div class="code-block" data-lang="Azurite (before)"><pre>DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:<span class="acc">10000</span>/devstoreaccount1;QueueEndpoint=http://127.0.0.1:<span class="acc">10001</span>/devstoreaccount1;TableEndpoint=http://127.0.0.1:<span class="acc">10002</span>/devstoreaccount1;</pre></div>
        <div class="code-block" data-lang="floci-az (after)"><pre>DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1;QueueEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1<span class="acc">-queue</span>;TableEndpoint=http://localhost:<span class="acc">4577</span>/devstoreaccount1<span class="acc">-table</span>;</pre></div>
      </div>
      <div class="reveal migrate-table">
        <h3 class="table-title">Default credentials</h3>
        <p class="table-intro">The following fixed credentials match Azurite's defaults. All Azure SDK tooling expects these values for local development.</p>
        <div class="conn-wrap">
          <table class="conn-table">
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              <tr><td>Account Name</td><td><code>devstoreaccount1</code></td></tr>
              <tr><td>Account Key</td><td><code>Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==</code></td></tr>
              <tr><td>Blob endpoint</td><td><code>http://localhost:4577/devstoreaccount1</code></td></tr>
              <tr><td>Queue endpoint</td><td><code>http://localhost:4577/devstoreaccount1-queue</code></td></tr>
              <tr><td>Table endpoint</td><td><code>http://localhost:4577/devstoreaccount1-table</code></td></tr>
              <tr><td>Event Hubs AMQP</td><td><code>amqp://localhost:5672</code></td></tr>
              <tr><td>Service Bus AMQP</td><td><code>amqp://localhost:5673</code></td></tr>
              <tr><td>Event Hubs Kafka (opt-in)</td><td><code>localhost:9093</code></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</CloudPage>

<style>
  :root {
    --bar-track: rgba(255,255,255,0.05); --row-hover: rgba(255,255,255,0.02);
  }
  html.light {
    --row-hover: rgba(0,0,0,0.02);
  }

  /* CODE */
  .qs-method-tabs { display: flex; gap: 4px; margin-top: 40px; border-bottom: 1px solid var(--border); }
  .qs-method-tab { min-height: 44px; padding: 10px 22px; font-size: 13px; font-family: var(--mono); color: var(--text-muted); background: transparent; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: color 0.15s, border-color 0.15s; margin-bottom: -1px; }
  .qs-method-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .qs-method-tab:hover:not(.active) { color: var(--text); }
  .qs-panel { margin-top: 36px; }
  .qs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; }
  @media (max-width: 768px) { .qs-grid { grid-template-columns: minmax(0, 1fr); } }

  /* CONNECTION TABLE */
  /* A connection string is one unbroken value: wrap it for reading, never insert line breaks. */
  .conn-string pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  .conn-note { margin: 0 0 12px; }
</style>

<script>
const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), {threshold: 0.1});
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));


document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#qsMethodTabs .qs-method-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('.qs-panel').forEach(function(p) { p.style.display = 'none'; });
    const panel = document.getElementById('qspanel-' + tab.dataset.qs);
    if (panel) panel.style.display = 'block';
  });
});

document.querySelectorAll('#installTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#installTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('itab-' + tab.getAttribute('data-tab'));
    if (target) target.style.display = 'block';
  });
});

document.querySelectorAll('#sdkTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('#sdkTabs .code-tab').forEach(function(t) { t.classList.remove('active'); });
    tab.classList.add('active');
    document.querySelectorAll('[id^="stab-"]').forEach(function(p) { p.style.display = 'none'; });
    const target = document.getElementById('stab-' + tab.dataset.tab);
    if (target) target.style.display = 'block';
  });
});

</script>
