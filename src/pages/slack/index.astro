---
// Single source of truth for the Slack invite: every repo links to floci.io/slack.
// When the invite expires, update this one URL.
export const prerender = true;
const dest = 'https://join.slack.com/t/floci/shared_invite/zt-4g24bsp0h-fl1Z0xFuFE9AtPu5yF6GVg';
---
<meta http-equiv="refresh" content={`0;url=${dest}`}>
<meta name="robots" content="noindex">
<link rel="canonical" href={dest}>
<script define:vars={{ dest }}>window.location.replace(dest)</script>
