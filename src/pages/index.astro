  .sponsor-slot-plus { font-size: 22px; line-height: 1; margin-bottom: 6px; }
  .sponsor-perks { text-align: left; margin-top: 16px; display: flex; flex-direction: column; gap: 6px; }
  .sponsor-perk { font-size: 12px; color: var(--text-muted); display: flex; align-items: flex-start; gap: 6px; }
  .sponsor-perk::before { content: '✓'; color: var(--accent); font-size: 11px; flex-shrink: 0; margin-top: 1px; }

  .sponsor-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .sponsor-actions .btn-primary {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, var(--accent-deep), var(--accent-warm));
    box-shadow: 0 8px 32px rgba(85,89,167,0.4);
  }
  .sponsor-actions .btn-primary::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.25) 50%, transparent 60%);
    transform: translateX(-120%); transition: transform 0.6s ease;
  }
  .sponsor-actions .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(85,89,167,0.55); }
  .sponsor-actions .btn-primary:hover::after { transform: translateX(120%); }

  /* Sponsors — light theme */
  html.light .sponsor-banner { --sp-glow: 85,89,167; }
  html.light .sponsor-banner::before {
    background: conic-gradient(from var(--sponsor-angle, 0deg),
      rgba(85,89,167,0.08), rgba(85,89,167,0.55) 12%, rgba(68,72,140,0.9) 17%, rgba(85,89,167,0.55) 22%,
      rgba(85,89,167,0.08) 38%, rgba(85,89,167,0.08) 60%, rgba(85,89,167,0.35) 78%, rgba(85,89,167,0.08));
  }
  html.light .sponsor-tier { background: linear-gradient(180deg, #FFFFFF, var(--bg2)); }
  html.light .tier-gold {
    background:
      linear-gradient(180deg, #FFFFFF, var(--bg2)) padding-box,
      linear-gradient(160deg, rgba(196,152,50,0.8), rgba(85,89,167,0.55) 40%, rgba(85,89,167,0.2) 70%, rgba(196,152,50,0.6)) border-box;
    box-shadow: 0 12px 48px rgba(57,73,171,0.15), 0 2px 12px rgba(0,0,0,0.06);
  }
  html.light .tier-gold .sponsor-tier-name { color: #A67C2E; }
  html.light .tier-gold .sponsor-tier-price {
    background: linear-gradient(100deg, #A67C2E 20%, #D4AF5E 40%, #A67C2E 60%);
    background-size: 200% 100%;
