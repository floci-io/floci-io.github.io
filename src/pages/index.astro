---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import sponsorsData from '../data/sponsors.json';
import { SERVICE_COUNTS, CARD_CHIPS, moreLabel, OUTCOME_MESSAGES } from '../data/services';
---

<Layout
  title="Floci — Local Cloud Emulators"
  description="Floci runs AWS, Azure, GCP, and OCI locally in milliseconds: a fast, free, credential-free feedback loop for developers and AI coding agents. MIT licensed. No account, no auth token."
  canonical="https://floci.io"
  ogImage="https://floci.io/og/home.png"
>
  <Nav active="home" githubUrl="https://github.com/floci-io" docsUrl="https://github.com/floci-io" />

  <!-- HERO -->
  <section class="hero" id="main-content">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>

    <div class="hero-logo-wrap">
      <svg class="hero-logo-svg" viewBox="0 0 531.25 156.71" xmlns="http://www.w3.org/2000/svg" aria-label="floci" role="img">
