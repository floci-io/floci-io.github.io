    background: conic-gradient(from var(--sponsor-angle, 0deg),
      rgba(var(--sp-glow),0.07),
      rgba(var(--sp-glow),0.55) 12%,
      rgba(232,233,248,0.9) 17%,
      rgba(var(--sp-glow),0.55) 22%,
      rgba(var(--sp-glow),0.07) 38%,
      rgba(var(--sp-glow),0.07) 60%,
      rgba(var(--sp-glow),0.35) 78%,
      rgba(var(--sp-glow),0.07));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask-composite: exclude;
    animation: sponsor-rotate 9s linear infinite;
  }
  /* blueprint grid, faded from the top */
  .sponsor-banner::after {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(var(--sp-glow),0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--sp-glow),0.07) 1px, transparent 1px);
    background-size: 44px 44px;
