  html.light .tier-gold .sponsor-perk::before { color: #A67C2E; }
  html.light .tier-flag { box-shadow: 0 4px 16px rgba(166,124,46,0.3); }
  html.light .sponsor-logo { background: linear-gradient(180deg, #FFFFFF, var(--bg2)); }

  /* Sponsors — reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sponsor-banner::before, .sponsor-aurora, .tier-flag,
    .tier-gold .sponsor-tier-price, .sponsor-slot-plus,
    .sponsor-logo.empty .sponsor-logo-plus, .sponsor-eyebrow::before { animation: none; }
    .sponsor-actions .btn-primary::after { display: none; }
