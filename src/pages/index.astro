    /* Sponsor */
    .sponsor-banner { padding: 44px 20px; }
    .sponsor-banner p { font-size: 15px; }
    .sponsor-aurora { width: 120%; }
    .sponsors-row { flex-direction: column; align-items: flex-start; gap: 10px; }
    .sponsors-row-label { min-width: unset; }
    .sponsor-actions { flex-direction: column; align-items: stretch; }
    .sponsor-actions a { text-align: center; }

    /* Section desc */
    .section-desc { font-size: 16px; }

    section { padding: 72px 1.25rem; }
  }

  /* ── MOBILE: 480px ─────────────────────────────────── */
  @media (max-width: 480px) {
    .hero { padding: 100px 1rem 50px; }
    .hero h1 { letter-spacing: -1px; }
