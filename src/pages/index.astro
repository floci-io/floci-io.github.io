    animation: pulse 2s ease-in-out infinite;
  }
  .outcome-port { color: var(--accent); }
  .install-footer {
    margin-top: 16px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
  }
  .install-link { font-family: var(--mono); font-size: 13px; text-decoration: none; }
  .install-link.aws-link { color: #FF9900; }
  .install-link.az-link  { color: #0078D4; }
  .install-link.gcp-link { color: #34A853; }
  .install-link.oci-link { color: #C74634; }
  .install-link-sep { color: var(--text-dim); }

  /* SPONSORS — animated shell */
  @property --sponsor-angle {
    syntax: '<angle>'; initial-value: 0deg; inherits: false;
  }
  @keyframes sponsor-rotate { to { --sponsor-angle: 360deg; } }
  @keyframes sponsor-breathe { 0%,100%{opacity:.6;transform:translateX(-50%) scale(1)} 50%{opacity:1;transform:translateX(-50%) scale(1.06)} }
  @keyframes sponsor-shimmer { 0%{background-position:-200% 0} 100%{background-position:200% 0} }
  @keyframes sponsor-plus-pulse { 0%,100%{transform:scale(1);opacity:.65} 50%{transform:scale(1.18);opacity:1} }

  .sponsor-banner {
    --sp-glow: 122,127,214;
    position: relative; overflow: hidden; isolation: isolate;
    border: none; border-radius: 20px;
    padding: 64px 48px; text-align: center;
    background:
      radial-gradient(ellipse 60% 45% at 50% 0%, rgba(var(--sp-glow),0.13), transparent 70%),
      linear-gradient(180deg, rgba(85,89,167,0.08), rgba(85,89,167,0.02) 45%),
