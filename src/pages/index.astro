---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import sponsorsData from '../data/sponsors.json';
import { SERVICE_COUNTS, OUTCOME_MESSAGES, CLOUD_LABELS, CLOUD_PORTS, CLOUD_SUMMARIES, CLOUD_PACKAGES, CLOUD_PAGES, CARD_CHIPS, moreLabel, type Cloud } from '../data/services';

// Home-page cloud cards, in nav order. The class matches the --chip colour rules below.
const CLOUD_CARDS: { key: Cloud; cls: string }[] = [
  { key: 'aws', cls: 'cloud-aws' },
  { key: 'azure', cls: 'cloud-az' },
  { key: 'gcp', cls: 'cloud-gcp' },
  { key: 'oci', cls: 'cloud-oci' },
];

// sponsors.json labels carry a medal emoji; the page shows the plain tier name.
const tierName =(label: string) => label.replace(/^[^\p{L}]+/u, '');
---

<Layout
  title="Floci: Any cloud. Locally. The local cloud for AI agents"
  description="Floci is the local cloud for AI coding agents: AWS, Azure, GCP, and OCI emulators that start in milliseconds, so agents build and test against a real-shaped cloud with no credentials and no bill. MIT licensed. No account, no auth token."
  canonical="https://floci.io"
  ogImage="https://floci.io/og/home.png"
>
  <Nav active="home" />

  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1><span class="accent">Any cloud.</span><br>Locally.</h1>
        <p class="hero-sub">
          A local cloud your coding agents can't break. AWS, Azure, GCP and OCI emulators that start in 24 ms: no credentials, no bill, no blast radius.
        </p>
        <div class="hero-actions">
          <a href="#ai" class="btn-primary">Set up your agent</a>
          <a href="https://github.com/floci-io" class="btn-ghost" target="_blank">GitHub<span id="ghHeroStars"></span></a>
        </div>
      </div>

      <div class="hero-term">
        <div class="code-block" data-lang="bash"><pre
><span class="comment"># Install floci-cli</span>
<span class="cmd">curl -fsSL <span class="acc">https://floci.io/install.sh</span> | sh</span>

<span class="comment"># Start the AWS emulator and load its endpoints</span>
<span class="cmd">floci start &amp;&amp; eval <span class="str">$(</span>floci env<span class="str">)</span></span></pre></div>
        <div class="install-outcome">
          <span class="outcome-dot"></span>
          <span set:html={OUTCOME_MESSAGES.aws}></span>
        </div>
        <p class="hero-note">
          Needs Docker or Podman running.
          <a href="#install">Read install.sh</a>
          <a href="#install">Homebrew, Windows and other options</a>
        </p>
      </div>
    </div>
  </section>

  <!-- AI AGENTS -->
  <section id="ai">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Built for AI coding agents</div>
        <h2>Give your AI agents a cloud they can't break.</h2>
        <p class="section-desc">Coding agents write cloud code faster than ever, but they can't safely run it against a real account. Point them at Floci instead: a local cloud to build, run, and verify against. Instant, free, and credential-free.</p>
      </div>

      <div class="agent-grid reveal reveal-delay">
        <div class="agent-loop">
          <h3 class="agent-title">The agent loop, on any cloud</h3>
          <div class="code-tabs" id="agentTabs" role="tablist" aria-label="Cloud">
            <button class="code-tab cloud-aws active" data-agent="aws" id="agent-btn-aws" role="tab" aria-controls="agent-aws" aria-selected="true"><span class="tab-dot" aria-hidden="true"></span>AWS</button>
            <button class="code-tab cloud-az" data-agent="az" id="agent-btn-az" role="tab" aria-controls="agent-az" aria-selected="false"><span class="tab-dot" aria-hidden="true"></span>Azure</button>
            <button class="code-tab cloud-gcp" data-agent="gcp" id="agent-btn-gcp" role="tab" aria-controls="agent-gcp" aria-selected="false"><span class="tab-dot" aria-hidden="true"></span>GCP</button>
            <button class="code-tab cloud-oci" data-agent="oci" id="agent-btn-oci" role="tab" aria-controls="agent-oci" aria-selected="false"><span class="tab-dot" aria-hidden="true"></span>OCI</button>
          </div>
          <div id="agent-aws" class="code-block tabbed" role="tabpanel" aria-labelledby="agent-btn-aws" data-lang="bash"><pre
><span class="comment"># agent task: add an upload endpoint backed by S3</span>
<span class="cmd">floci start</span>
<span class="cmd">eval $(floci env)</span>       <span class="comment"># endpoint → :4566</span>
<span class="cmd">aws s3 mb s3://<span class="acc">uploads</span></span>
<span class="cmd">pytest tests/</span>           <span class="comment"># ✓ no AWS account used</span></pre></div>
          <div id="agent-az" class="code-block tabbed" role="tabpanel" aria-labelledby="agent-btn-az" data-lang="bash" hidden><pre
><span class="comment"># agent task: store invoices in Blob Storage</span>
<span class="cmd">floci az start</span>
<span class="cmd">eval $(floci az env)</span>    <span class="comment"># endpoint → :4577</span>
<span class="cmd">az storage container create --name <span class="acc">invoices</span></span>
<span class="cmd">pytest tests/</span>           <span class="comment"># ✓ no Azure subscription used</span></pre></div>
          <div id="agent-gcp" class="code-block tabbed" role="tabpanel" aria-labelledby="agent-btn-gcp" data-lang="bash" hidden><pre
><span class="comment"># agent task: publish order events to Pub/Sub</span>
<span class="cmd">floci gcp start</span>
<span class="cmd">eval $(floci gcp env)</span>   <span class="comment"># SDK endpoints → :4588</span>
<span class="comment"># gcloud needs its own override, plus a dummy token</span>
<span class="cmd">export CLOUDSDK_API_ENDPOINT_OVERRIDES_PUBSUB=http://localhost:4588/</span>
<span class="cmd">export CLOUDSDK_CORE_PROJECT=floci-local CLOUDSDK_AUTH_ACCESS_TOKEN=floci</span>
<span class="cmd">gcloud pubsub topics create <span class="acc">orders</span></span>
<span class="cmd">pytest tests/</span>           <span class="comment"># ✓ no GCP project used</span></pre></div>
          <div id="agent-oci" class="code-block tabbed" role="tabpanel" aria-labelledby="agent-btn-oci" data-lang="bash" hidden><pre
><span class="comment"># agent task: archive reports to Object Storage</span>
<span class="cmd">floci oci start</span>
<span class="cmd">floci oci setup</span>         <span class="comment"># throwaway profile, once</span>
<span class="cmd">eval $(floci oci env)</span>   <span class="comment"># endpoint → :4599</span>
<span class="cmd">oci os ns get</span>
<span class="cmd">pytest tests/</span>           <span class="comment"># ✓ no OCI tenancy used</span></pre></div>
        </div>
        <div class="agent-rules">
          <h3 class="agent-title">Teach your agent once</h3>
          <div class="code-block" data-lang="bash"><pre
><span class="comment"># Asks which agents to install it for</span>
<span class="cmd">npx skills add <span class="acc">floci-io/floci-cli</span></span></pre></div>
          <p class="agent-caption">The Floci skill teaches Claude Code, Codex, Cursor, Kiro and other coding agents to run the emulators with floci-cli.</p>
          <details class="agent-manual">
            <summary><span>No skill support? Paste these rules into <code>AGENTS.md</code> or <code>CLAUDE.md</code></span></summary>
          <div class="code-block" data-lang="AGENTS.md"><pre
><span class="comment">## Local cloud (floci)</span>
- Never run code or tests against a real cloud account. Use floci instead.
- Start the emulator you need: <span class="acc">`floci start`</span> (AWS), <span class="acc">`floci az start`</span>, <span class="acc">`floci gcp start`</span> or <span class="acc">`floci oci start`</span>.
- Load its endpoints before running anything: <span class="acc">`eval $(floci env)`</span> (or <span class="acc">`floci az env`</span>, <span class="acc">`floci gcp env`</span>, <span class="acc">`floci oci env`</span>).
- State is disposable: <span class="acc">`floci stop`</span> then <span class="acc">`floci start`</span> gives you a clean cloud.</pre></div>
          </details>
        </div>
      </div>

      <p class="agent-works reveal">Works with <strong>Claude Code</strong>, <strong>Cursor</strong>, <strong>GitHub Copilot</strong>, <strong>OpenAI Codex</strong>, <strong>Aider</strong> and <strong>Gemini CLI</strong>: anything that can run a shell command.</p>

      <ul class="proof-list reveal">
        <li>
          <h3>No real credentials, nothing to break.</h3>
          <p>Agents connect with throwaway keys, so no cloud secret reaches their context or sandbox. Worst case, they reset a local container, not your staging environment or your bill.</p>
        </li>
        <li>
          <h3>Starts in 24 ms, idles at 13 MiB.</h3>
          <p>The native binary is fast enough to start, test and tear down inside the edit loop. With Docker, add the image pull the first time.</p>
        </li>
        <li>
          <h3>Real engines, not mocks.</h3>
          <p>Lambda runs in real Docker containers, RDS on real PostgreSQL and MySQL, ElastiCache on real Redis. Real wire protocols, so code an agent verifies locally behaves the same in production.</p>
        </li>
        <li>
          <h3>MIT, free forever, no auth token.</h3>
          <p>No sign-up, no API key, no telemetry, no paid tier or feature flags. Every service is available to everyone.</p>
        </li>
      </ul>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Cloud Emulators</div>
        <h2>Four clouds. Four emulators.</h2>
        <p class="section-desc">Each one is standalone, runs on its own port, and needs no cloud account. Run one, or all four side&nbsp;by&nbsp;side.</p>
      </div>

      <!-- One quadrant per emulator, split by hairlines. The cloud link stretches over its quadrant. -->
      <ul class="emu reveal reveal-delay">
        {CLOUD_CARDS.map(({ key, cls }) => {
          const listed = CARD_CHIPS[key].slice(0, 5);
          return (
            <li class={`emu-item ${cls}`}>
              <div class="emu-head">
                <a href={CLOUD_PAGES[key]} class="emu-name"><span class="emu-dot" aria-hidden="true"></span>{CLOUD_LABELS[key]}</a>
                <span class="emu-meta">{CLOUD_PACKAGES[key]} · :{CLOUD_PORTS[key]}</span>
              </div>
              <p class="emu-summary">{CLOUD_SUMMARIES[key]}</p>
              <p class="emu-services">
                <span class="emu-count">{SERVICE_COUNTS[key]} services</span>
                {listed.join(', ')} <span class="emu-more">{moreLabel(key, listed)}</span>
              </p>
              <span class="emu-arrow" aria-hidden="true">→</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- INSTALL -->
  <section id="install">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Quick Start</div>
        <h2>Install floci-cli and make your first bucket.</h2>
        <p class="section-desc">No account, no token. One CLI starts and manages all four emulators.</p>
      </div>

      <div class="install-wrap reveal reveal-delay">
        <div class="install-tabs" id="installTabs" role="tablist" aria-label="Install method">
          <button class="install-tab active" data-tab="cli" id="install-btn-cli" role="tab" aria-controls="itab-cli" aria-selected="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            macOS / Linux
          </button>
          <button class="install-tab" data-tab="brew" id="install-btn-brew" role="tab" aria-controls="itab-brew" aria-selected="false">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h11v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M16 11h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2"/><path d="M5 8a3 3 0 0 1 3-3 3 3 0 0 1 5 0 3 3 0 0 1 3 3"/></svg>
            Homebrew
          </button>
          <button class="install-tab" data-tab="win" id="install-btn-win" role="tab" aria-controls="itab-win" aria-selected="false">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 3.5L9.9 2.3v9.4H0zm11 0l13-1.8v11.5H11zM0 12.8h9.9V22L0 20.8zm11 .1h13V22L11 20.6z"/></svg>
            Windows
          </button>
        </div>

        <div id="itab-cli" class="install-block" data-copy-mode="commands" role="tabpanel" aria-labelledby="install-btn-cli">
          <span class="comment"># Install floci-cli</span><br>
          <span class="cmd">curl -fsSL <span class="acc">https://floci.io/install.sh</span> | sh</span><br><br>
          <span class="comment"># Start the AWS emulator and load its endpoints</span><br>
          <span class="cmd">floci start &amp;&amp; eval <span class="str">$(</span>floci env<span class="str">)</span></span><br><br>
          <span class="comment"># Create a bucket</span><br>
          <span class="cmd">aws s3 mb s3://my-bucket</span><br><br>
          <span class="comment"># Upload a file</span><br>
          <span class="cmd">echo <span class="str">"hello from floci"</span> &gt; hello-floci.txt</span><br>
          <span class="cmd">aws s3 cp hello-floci.txt s3://my-bucket/</span><br><br>
          <span class="comment"># Download it back</span><br>
          <span class="cmd">aws s3 cp s3://my-bucket/hello-floci.txt hello-back.txt</span><br>
          <span class="cmd">cat hello-back.txt</span>
        </div>

        <div id="itab-brew" class="install-block" data-copy-mode="commands" role="tabpanel" aria-labelledby="install-btn-brew" hidden>
          <span class="comment"># Install floci-cli</span><br>
          <span class="cmd">brew install <span class="acc">floci-io/floci/floci</span></span><br><br>
          <span class="comment"># Start the AWS emulator and load its endpoints</span><br>
          <span class="cmd">floci start &amp;&amp; eval <span class="str">$(</span>floci env<span class="str">)</span></span><br><br>
          <span class="comment"># Create a bucket</span><br>
          <span class="cmd">aws s3 mb s3://my-bucket</span><br><br>
          <span class="comment"># Upload a file</span><br>
          <span class="cmd">echo <span class="str">"hello from floci"</span> &gt; hello-floci.txt</span><br>
          <span class="cmd">aws s3 cp hello-floci.txt s3://my-bucket/</span><br><br>
          <span class="comment"># Download it back</span><br>
          <span class="cmd">aws s3 cp s3://my-bucket/hello-floci.txt hello-back.txt</span><br>
          <span class="cmd">cat hello-back.txt</span>
        </div>

        <div id="itab-win" class="install-block" data-copy-mode="commands" role="tabpanel" aria-labelledby="install-btn-win" hidden>
          <span class="comment"># Install floci-cli (PowerShell)</span><br>
          <span class="cmd">irm <span class="acc">https://floci.io/install.ps1</span> | iex</span><br><br>
          <span class="comment"># Start the AWS emulator and load its endpoints</span><br>
          <span class="cmd">floci start; floci env | Invoke-Expression</span><br><br>
          <span class="comment"># Create a bucket</span><br>
          <span class="cmd">aws s3 mb s3://my-bucket</span><br><br>
          <span class="comment"># Upload a file</span><br>
          <span class="cmd"><span class="str">"hello from floci"</span> | Out-File hello-floci.txt</span><br>
          <span class="cmd">aws s3 cp hello-floci.txt s3://my-bucket/</span><br><br>
          <span class="comment"># Download it back</span><br>
          <span class="cmd">aws s3 cp s3://my-bucket/hello-floci.txt hello-back.txt; Get-Content hello-back.txt</span>
        </div>

        <div class="install-outcome" id="installOutcome">
          <span class="outcome-dot"></span>
          <span set:html={OUTCOME_MESSAGES.aws}></span>

        </div>

        <p class="install-help">Something not starting? Run <code>floci doctor</code>.</p>

        <p class="install-footer">
          <span class="install-footer-label">Prefer Docker?</span>
          <a href="/aws/#quickstart" class="install-link cloud-aws">AWS</a>
          <a href="/az/#quickstart" class="install-link cloud-az">Azure</a>
          <a href="/gcp/#quickstart" class="install-link cloud-gcp">GCP</a>
          <a href="/oci/#quickstart" class="install-link cloud-oci">OCI</a>
        </p>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section id="tools">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Developer Tools</div>
        <h2>One toolchain. All clouds.</h2>
        <p class="section-desc">Manage and explore every Floci emulator from a unified CLI or visual dashboard.</p>
      </div>

      <div class="hairline reveal reveal-delay"><div class="hairline-grid cols-2">
        <!-- floci-cli -->
        <div class="tool-card">
          <div class="tool-tag">CLI</div>
          <div class="tool-name">floci-cli</div>
          <p class="tool-desc">A unified command-line interface to start, stop, and inspect all Floci emulators. One install covers AWS, Azure, GCP, and OCI from a single tool.</p>
          <p class="tool-hint">Something not starting? <code>floci doctor</code> checks Docker, ports and your environment.</p>
          <div class="tool-actions">
            <a href="https://github.com/floci-io/floci-cli" class="btn-ghost btn-sm" target="_blank">floci-cli on GitHub →</a>
          </div>
        </div>

        <!-- floci-ui -->
        <div class="tool-card">
          <div class="tool-tag">UI</div>
          <div class="tool-name">floci-ui</div>
          <p class="tool-desc">A visual dashboard for all Floci cloud emulators. Browse resources, inspect data, and manage services across AWS, Azure, GCP, and OCI from one place.</p>
          <a class="ui-shot" href="/tools/floci-ui-console.png" target="_blank" rel="noopener" aria-label="Open the floci-ui console screenshot full size">
            <span class="ui-shot-bar" aria-hidden="true"><span class="ui-shot-url">localhost:4500/console/aws</span></span>
            <img src="/tools/floci-ui-console-800.webp" srcset="/tools/floci-ui-console-800.webp 800w, /tools/floci-ui-console-1600.webp 1600w" sizes="(max-width: 768px) 100vw, 520px" width="1600" height="1000" loading="lazy" decoding="async"
              alt="floci-ui Console Home for AWS: runtime reachable, 19 active services, and a grid of services such as Compute, Storage, SQS and EventBridge with their resource counts." />
          </a>
          <div class="tool-actions">
            <a href="https://github.com/floci-io/floci-ui" class="btn-ghost btn-sm" target="_blank">floci-ui on GitHub →</a>
          </div>
        </div>
      </div></div>
    </div>
  </section>

  <!-- USE CASES -->
  <section id="use-cases">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Use Cases</div>
        <h2>On laptops, in CI and in workshops.</h2>
        <p class="section-desc">Anywhere a real cloud account is too slow, too risky, or too expensive.</p>
      </div>

      <div class="uc-layout reveal">
        <ul class="proof-list uc-list">
          <li>
            <h3>One cloud per CI job.</h3>
            <p>Run Floci as a service container. Every job gets an isolated cloud, and teardown is free.</p>
          </li>
          <li>
            <h3>Local-first development.</h3>
            <p>Build against S3, Pub/Sub or Service Bus on your laptop, offline if you want. No shared dev account, no credentials to rotate.</p>
          </li>
          <li>
            <h3>Infrastructure-as-code dry runs.</h3>
            <p>Apply Terraform, OpenTofu or CloudFormation against localhost first, and catch drift and bad refactors before a real account sees them.</p>
          </li>
          <li>
            <h3>Workshops and onboarding.</h3>
            <p>Every student runs the whole stack on their own machine with zero billing risk. Start from the <a href="/labs/">101 Labs</a>.</p>
          </li>
        </ul>
        <div class="code-block" data-lang=".github/workflows/test.yml"><pre
><span class="cmd">jobs:
  test:
    runs-on: ubuntu-latest
    services:
      floci:
        image: <span class="acc">floci/floci</span>
        ports: [<span class="str">"4566:4566"</span>]
    env:
      AWS_ENDPOINT_URL: http://localhost:4566
      AWS_ACCESS_KEY_ID: test
      AWS_SECRET_ACCESS_KEY: test
      AWS_DEFAULT_REGION: us-east-1
    steps:
      - uses: actions/checkout@v4
      - run: pytest tests/</span></pre></div>
      </div>
      </div>
    </div>
  </section>

  <!-- SPONSORS -->
  <section id="sponsors">
    <div class="container">
      <div class="sponsor-panel reveal">
        <div class="sponsor-intro">
          <h2>We're looking for sponsors</h2>
          <p>Floci is free, MIT licensed, and built in the open. Sponsorships help us keep it that way, funding infrastructure, development time, and new cloud emulators.</p>
          <div class="sponsor-actions">
            <a href="https://github.com/sponsors/floci-io" target="_blank" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.593c-.425-.439-8.801-9.101-8.801-13.108 0-4.063 3.318-7.36 7.4-7.36 1.748 0 3.345.606 4.601 1.608C16.456 1.73 18.053 1.125 19.801 1.125c4.082 0 7.4 3.297 7.4 7.36-.001 4.007-8.376 12.669-8.801 13.108l-3.2 3.282-3.2-3.282zm.8-17.718a5.578 5.578 0 0 0-4 1.686 5.578 5.578 0 0 0-4-1.686c-3.073 0-5.6 2.498-5.6 5.61 0 3.007 6.921 10.526 9.6 13.284 2.679-2.758 9.6-10.277 9.6-13.284 0-3.112-2.527-5.61-5.6-5.61z"/></svg>
              GitHub Sponsors
            </a>
            <a href="/contact/?topic=sponsorship" class="btn-ghost">Contact us</a>
          </div>
        </div>

        {sponsorsData.tiers.some(t => t.sponsors.length > 0) && (
          <div class="sponsors-current">
            {sponsorsData.tiers.filter(t => t.sponsors.length > 0).map(tier => (
              <div class="sponsors-group">
                <div class="sponsors-group-label">{tierName(tier.label)}</div>
                {tier.id === 'community'
                  ? <p class="sponsors-names">
                      {tier.sponsors.map((s, i) => (
                        <>{i > 0 && ', '}{s.url ? <a href={s.url} target="_blank">{s.name}</a> : s.name}</>
                      ))}
                    </p>
                  : <div class="sponsors-logos">
                      {tier.sponsors.map(s => (
                        <a href={s.url} target="_blank" class:list={['sponsor-logo', `${tier.id}-slot`, { person: s.person }]}>
                          {s.logo
                            ? <img src={s.logo} alt="" class:list={['sponsor-logo-img', { invert: s.invert }]} />
                            : <span class="sponsor-logo-mark" aria-hidden="true">{s.name.slice(0,2).toUpperCase()}</span>}
                          <span class="sponsor-logo-name">{s.name}</span>
                        </a>
                      ))}
                    </div>}
              </div>
            ))}
          </div>
        )}

        <dl class="sponsor-tiers">
          {sponsorsData.tiers.map(tier => (
            <div class="sponsor-tier">
              <dt>{tierName(tier.label)}</dt>
              <dd class="sponsor-tier-price">{tier.price}</dd>
              <dd class="sponsor-tier-perks">{tier.perks.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- CLOSING: where to go next, instead of repeating the install a fourth time. -->
  <section id="start" class="closing">
    <div class="container reveal">
      <h2>Where to next.</h2>
