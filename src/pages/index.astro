<script>

// Reveal
const obs = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }), { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// Install tabs

function activateTab(tabKey) {
  document.querySelectorAll('#installTabs .install-tab').forEach(function(t) {
    const on = t.dataset.tab === tabKey;
    t.classList.toggle('active', on);
    t.setAttribute('aria-selected', String(on));
    t.tabIndex = on ? 0 : -1;
  });
  document.querySelectorAll('.install-block[id^="itab-"]').forEach(function(p) { p.hidden = true; });
  const panel = document.getElementById('itab-' + tabKey);
  if (panel) panel.hidden = false;
}

// Auto-detect OS
const isWindows = navigator.platform.startsWith('Win') || /Windows/.test(navigator.userAgent);
activateTab(isWindows ? 'win' : 'cli');

document.querySelectorAll('#installTabs .install-tab').forEach(function(tab) {
  tab.addEventListener('click', function() { activateTab(tab.dataset.tab); });
});

// Agent loop tabs
function activateAgent(key) {
  document.querySelectorAll('#agentTabs .code-tab').forEach(function(t) {
    const on = t.dataset.agent === key;
    t.classList.toggle('active', on);
    t.setAttribute('aria-selected', String(on));
    t.tabIndex = on ? 0 : -1;
    const panel = document.getElementById('agent-' + t.dataset.agent);
    if (panel) panel.hidden = !on;
  });
}
document.querySelectorAll('#agentTabs .code-tab').forEach(function(tab) {
  tab.addEventListener('click', function() { activateAgent(tab.dataset.agent); });
});
activateAgent('aws');

// Arrow keys, Home and End move between tabs, as in the ARIA tabs pattern.
function tabKeys(listId, activate) {
  const list = document.getElementById(listId);
  if (!list) return;
  list.addEventListener('keydown', function(e) {
    const tabs = Array.from(list.querySelectorAll('[role="tab"]'));
    const i = tabs.indexOf(document.activeElement);
    if (i < 0) return;
    let next = -1;
    if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
    else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
    else if (e.key === 'Home') next = 0;
    else if (e.key === 'End') next = tabs.length - 1;
    if (next < 0) return;
    e.preventDefault();
    activate(tabs[next]);
    tabs[next].focus();
  });
}
tabKeys('installTabs', function(t) { activateTab(t.dataset.tab); });
tabKeys('agentTabs', function(t) { activateAgent(t.dataset.agent); });

// Hero GitHub stars
// GitHub stars: cached for the session, since the unauthenticated API allows 60 calls an hour.
function showStars(count) {
  const el = document.getElementById('ghHeroStars');
  if (!el || !count) return;
  el.textContent = ' · ' + (count >= 1000 ? (count / 1000).toFixed(1) + 'k' : count);
}
const cachedStars = Number(sessionStorage.getItem('floci-stars'));
if (cachedStars) showStars(cachedStars);
else fetch('https://api.github.com/repos/floci-io/floci').then(r => r.json()).then(data => {
  if (!data.stargazers_count) return;
  sessionStorage.setItem('floci-stars', String(data.stargazers_count));
  showStars(data.stargazers_count);
}).catch(() => {});
</script>
