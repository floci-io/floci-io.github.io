    content: ''; position: absolute; inset: 0; border-radius: inherit;
    padding: 1px; z-index: 2; pointer-events: none;
    background: conic-gradient(from var(--sponsor-angle, 0deg),
      rgba(var(--sp-glow),0.07),
      rgba(var(--sp-glow),0.55) 12%,
      rgba(232,233,248,0.9) 17%,
