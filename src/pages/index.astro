<script>
// Reveal
const obs = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }), { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// Install tabs
const outcomeMessages = {
  cli:   '47 AWS services ready on <span class="outcome-port">:4566</span> — S3 · SQS · DynamoDB · Lambda · RDS · +42 more',
  win:   '47 AWS services ready on <span class="outcome-port">:4566</span> — S3 · SQS · DynamoDB · Lambda · RDS · +42 more',
  aws:   '47 AWS services ready on <span class="outcome-port">:4566</span> — S3 · SQS · DynamoDB · Lambda · RDS · +42 more',
  azure: '8 Azure services ready on <span class="outcome-port">:4577</span> — Blob · Queue · Table · Functions · Key Vault · Event Hubs',
  gcp:   'Cloud Storage ready on <span class="outcome-port">:4588</span> — Pub/Sub &amp; Firestore coming next',
};

function activateTab(tabKey) {
  document.querySelectorAll('#installTabs .install-tab').forEach(function(t) { t.classList.remove('active'); });
  const activeTab = document.querySelector('#installTabs [data-tab="' + tabKey + '"]');
  if (activeTab) activeTab.classList.add('active');
  document.querySelectorAll('[id^="itab-"]').forEach(function(p) { p.style.display = 'none'; });
  const panel = document.getElementById('itab-' + tabKey);
  if (panel) panel.style.display = 'block';
  const outcomeText = document.getElementById('outcomeText');
  if (outcomeText) outcomeText.innerHTML = outcomeMessages[tabKey] || '';
}

// Auto-detect OS
const isWindows = navigator.platform.startsWith('Win') || /Windows/.test(navigator.userAgent);
activateTab(isWindows ? 'win' : 'cli');

document.querySelectorAll('#installTabs .install-tab').forEach(function(tab) {
  tab.addEventListener('click', function() { activateTab(tab.dataset.tab); });
});

// Hero GitHub stars
fetch('https://api.github.com/repos/floci-io/floci').then(r => r.json()).then(data => {
  const count = data.stargazers_count;
  if (!count) return;
  const fmt = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : count;
  const el = document.getElementById('ghHeroStars');
  if (el) el.textContent = ' · ' + fmt;
}).catch(() => {});
</script>
