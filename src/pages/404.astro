---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SERVICE_COUNTS } from '../data/services';
---

<Layout
  title="404 — Page Not Found · floci"
  description="The page you're looking for doesn't exist. Head back to floci and pick your cloud."
  canonical="https://floci.io/404/"
>
  <Nav active="home" githubUrl="https://github.com/floci-io" docsUrl="https://github.com/floci-io" />

  <section class="not-found">
    <div class="container">
      <div class="nf-glyph">404</div>
      <div class="section-label">Nothing here</div>
      <h1>Page not found.</h1>
      <p class="nf-sub">The URL you followed doesn't exist — it may have moved or never existed. Pick a cloud and carry on.</p>

      <div class="nf-cards">
        {[
          { href: '/aws/', cloud: 'aws', name: 'floci', desc: `${SERVICE_COUNTS.aws} AWS services` },
          { href: '/az/', cloud: 'az', name: 'floci-az', desc: `${SERVICE_COUNTS.azure} Azure services` },
          { href: '/gcp/', cloud: 'gcp', name: 'floci-gcp', desc: `${SERVICE_COUNTS.gcp} GCP services` },
          { href: '/oci/', cloud: 'oci', name: 'floci-oci', desc: `${SERVICE_COUNTS.oci} OCI services` },
        ].map((c) => (
          <a href={c.href} class={`nf-card ${c.cloud}`}>
            <svg class="nf-card-svg" viewBox="0 0 531.25 156.71" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <g style="isolation:isolate"><g style="isolation:isolate">
                <path class="floci-text" d="M305.44,141.35h-15.94V39.04h-17.08c-13.18,0-16.75,7.81-16.59,17.4v8.95h17.4v13.34h-17.4v62.62h-15.94v-62.62h-14.64v-13.34h14.64v-7.16c0-20.66,8.95-34.16,29.6-34.16h35.95v117.28Z"/>
                <path class="floci-text" d="M324.31,103.29c0-24.07,18.22-39.85,39.85-39.85s40.01,15.78,40.01,39.85-18.38,40.01-40.01,40.01-39.85-15.94-39.85-40.01ZM388.24,103.29c0-14.64-11.06-24.89-24.07-24.89s-23.91,10.25-23.91,24.89,10.9,25.05,23.91,25.05,24.07-10.25,24.07-25.05Z"/>
                <path class="floci-text" d="M418,103.29c0-24.07,19.03-39.85,40.99-39.85,12.36,0,22.93,5.04,29.6,13.01l-10.57,9.92c-4.39-4.88-11.06-7.97-18.71-7.97-14.15,0-25.38,10.41-25.38,24.89s11.22,25.05,25.38,25.05c7.65,0,14.31-3.09,18.71-7.97l10.57,9.92c-6.67,7.97-17.24,13.01-29.6,13.01-21.96,0-40.99-15.94-40.99-40.01Z"/>
                <path class="floci-text" d="M502.91,37.74c0-5.86,5.04-10.25,10.9-10.25s10.9,4.39,10.9,10.25-4.88,10.25-10.9,10.25-10.9-4.39-10.9-10.25ZM505.84,141.35v-75.96h15.94v75.96h-15.94Z"/>
              </g></g>
              <g>
                <path class="floci-cloud" d="M44.46,52.16l-1.44,9.05c-.1.64-35.57,8.08-30.51,43.05,2.04,14.08,14.69,31.06,31.94,31.22l84.34.78c3.64.03,7.49.5,9.97,2.81,1.69,1.57,1.95,6.1-.29,9.22l-83.49.43c-22.68.12-43.45-11.19-51.76-32.9-8.64-22.56.61-49.48,22.58-59.54,5.11-2.34,7.7-4,8.39-9.37l10.28,5.24h-.01Z"/>
                <path class="floci-cloud" d="M44.46,52.16l-10.28-5.24c1.94-15.09,10.61-28.25,23.15-36.38C74.85-.82,94.57-3.69,115.01,5.35c14.93,6.6,26.96,21.97,32.12,39.33,26.07,3.63,46.19,26.18,40.75,53.8-3.06.86-9.18-1.15-11.34-3.72,1.28-12.11-3.1-22.27-10.75-29.43-8.19-7.67-17.88-9.28-30.09-8.04-.09-25.91-19.81-43.97-43.82-45.33-22.91-1.29-43.59,16.13-47.42,40.2h0Z"/>
                <ellipse class="floci-dot" cx="173.57" cy="127.13" rx="20.36" ry="20.4"/>
                <ellipse class="floci-dot" cx="513.02" cy="37.71" rx="13.22" ry="13.25"/>
              </g>
            </svg>
            <div class="nf-card-name">{c.name}</div>
            <div class="nf-card-desc">{c.desc}</div>
          </a>
        ))}
      </div>

      <a href="/" class="btn-ghost" style="margin-top:40px">← Back to home</a>
    </div>
  </section>

  <Footer variant="main" />
</Layout>

<style>
  .not-found {
    min-height: calc(100vh - 60px);
    display: flex; align-items: center; justify-content: center;
    padding: 80px 2rem;
    text-align: center;
  }
  .container { display: flex; flex-direction: column; align-items: center; }
  .nf-glyph {
    font-family: var(--mono); font-size: clamp(80px, 16vw, 140px); font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 2px var(--border-bright);
    letter-spacing: -4px; line-height: 1; margin-bottom: 24px;
    user-select: none;
  }
  h1 { font-size: clamp(28px, 4vw, 44px); font-weight: 800; letter-spacing: -1px; margin-bottom: 16px; }
  .nf-sub { color: var(--text-muted); font-size: 17px; max-width: 480px; line-height: 1.65; margin-bottom: 48px; }

  .nf-cards { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; }
  .nf-card {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    padding: 28px 32px; border-radius: 14px; border: 1px solid var(--border);
    background: var(--bg2); text-decoration: none; color: var(--text);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    min-width: 140px;
  }
  .nf-card:hover { transform: translateY(-3px); box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
  .nf-card.aws:hover { border-color: rgba(255,153,0,0.4); }
  .nf-card.az:hover  { border-color: rgba(0,120,212,0.4); }
  .nf-card.gcp:hover { border-color: rgba(52,168,83,0.4); }
  .nf-card.oci:hover { border-color: rgba(199,70,52,0.4); }
  .nf-card-svg { height: 28px; width: auto; display: block; }
  .nf-card-svg .floci-text, .nf-card-svg .floci-cloud { fill: #F8FAFC; }
  html.light .nf-card-svg .floci-text { fill: #262425; }
  html.light .nf-card-svg .floci-cloud { fill: #151515; }
  .nf-card.aws .floci-dot { fill: #FF9900; }
  .nf-card.az .floci-dot  { fill: #0078D4; }
  .nf-card.gcp .floci-dot { fill: #34A853; }
  .nf-card.oci .floci-dot { fill: #C74634; }
  .nf-card-name { font-family: var(--mono); font-size: 16px; font-weight: 700; }
  .nf-card-desc { font-size: 12px; color: var(--text-muted); font-family: var(--mono); }
</style>
