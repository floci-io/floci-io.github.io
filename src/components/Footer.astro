---
export interface Props {
  variant: 'main' | 'sub';
}

const { variant } = Astro.props;
---

{variant === 'main' ? (
<footer>
  <div class="footer-logo">
    <svg width="20" height="15" viewBox="-10 -55 240 170" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="fpm" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fff8e1"/><stop offset="100%" stop-color="#ffe082"/></linearGradient>
        <linearGradient id="fps" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffe082"/><stop offset="100%" stop-color="#e6ac00"/></linearGradient>
      </defs>
      <g transform="translate(108,54)">
        <rect x="-108" y="-20" width="216" height="60" rx="30" fill="url(#fps)"/>
        <circle cx="-74" cy="-20" r="40" fill="url(#fps)"/>
        <circle cx="-22" cy="-44" r="52" fill="url(#fpm)"/>
        <circle cx="36" cy="-36" r="46" fill="url(#fpm)"/>
        <circle cx="86" cy="-18" r="34" fill="url(#fps)"/>
        <ellipse cx="8" cy="-30" rx="72" ry="28" fill="#fff8e1" opacity="0.45"/>
      </g>
    </svg>
    floci
  </div>

  <div class="footer-cols">
    <div class="footer-col">
      <h4>Emulators</h4>
      <a href="/floci/">floci (AWS)</a>
      <a href="/floci-az/">floci-az (Azure)</a>
      <a href="/floci-gcp/">floci-gcp (GCP)</a>
    </div>
    <div class="footer-col">
      <h4>Tools</h4>
      <a href="https://github.com/floci-io/floci-cli" target="_blank" rel="noopener noreferrer">floci-cli</a>
      <a href="https://github.com/floci-io/floci-ui" target="_blank" rel="noopener noreferrer">floci-ui</a>
    </div>
    <div class="footer-col">
      <h4>Resources</h4>
      <a href="https://github.com/floci-io/floci" target="_blank" rel="noopener noreferrer">floci on GitHub</a>
      <a href="https://github.com/floci-io" target="_blank" rel="noopener noreferrer">GitHub Org</a>
      <a href="https://hectorvent.dev/posts/introducing-floci/" target="_blank" rel="noopener noreferrer">Blog Post</a>
      <a href="#sponsors">Sponsors</a>
    </div>
  </div>

  <div class="footer-social">
    <a href="https://www.linkedin.com/company/floci/" target="_blank" rel="noopener noreferrer" title="LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
    </a>
    <a href="https://x.com/floci_io" target="_blank" rel="noopener noreferrer" title="X / Twitter">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <a href="https://www.reddit.com/r/floci/" target="_blank" rel="noopener noreferrer" title="Reddit">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .379-.239l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
    </a>
  </div>

  <div class="footer-copy">MIT License · Built with Quarkus + GraalVM · <a href="https://github.com/floci-io" target="_blank" rel="noopener noreferrer" style="color:var(--text-dim);text-decoration:none">github.com/floci-io</a></div>
</footer>
) : (
<footer class="footer-sub">
  <div class="footer-logo">
    <svg width="20" height="15" viewBox="-10 -55 240 170" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="fpm2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fff8e1"/><stop offset="100%" stop-color="#ffe082"/></linearGradient>
        <linearGradient id="fps2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffe082"/><stop offset="100%" stop-color="#e6ac00"/></linearGradient>
      </defs>
      <g transform="translate(108,54)">
        <rect x="-108" y="-20" width="216" height="60" rx="30" fill="url(#fps2)"/>
        <circle cx="-74" cy="-20" r="40" fill="url(#fps2)"/>
        <circle cx="-22" cy="-44" r="52" fill="url(#fpm2)"/>
        <circle cx="36" cy="-36" r="46" fill="url(#fpm2)"/>
        <circle cx="86" cy="-18" r="34" fill="url(#fps2)"/>
        <ellipse cx="8" cy="-30" rx="72" ry="28" fill="#fff8e1" opacity="0.45"/>
      </g>
    </svg>
    floci
  </div>
  <slot />
  <div class="footer-copy">MIT License · Built with Quarkus + GraalVM</div>
</footer>
)}

<style is:global>
  footer {
    border-top: 1px solid var(--border); padding: 40px 2rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 20px;
  }
  footer.footer-sub {
    justify-content: space-between;
  }
  .footer-logo { font-family: var(--mono); font-size: 16px; color: var(--accent); font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .footer-cols { display: flex; gap: 48px; flex-wrap: wrap; }
  .footer-col h4 { font-family: var(--mono); font-size: 11px; color: var(--text-dim); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; }
  .footer-col a { display: block; color: var(--text-dim); font-size: 13px; text-decoration: none; margin-bottom: 8px; transition: color 0.2s; }
  .footer-col a:hover { color: var(--text-muted); }
  .footer-social { display: flex; gap: 14px; align-items: center; }
  .footer-social a { color: var(--text-dim); transition: color 0.2s; }
  .footer-social a:hover { color: var(--text-muted); }
  .footer-copy { font-size: 12px; color: var(--text-dim); width: 100%; text-align: center; border-top: 1px solid var(--border); padding-top: 24px; margin-top: 8px; }
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer-links a { color: var(--text-dim); font-size: 13px; text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--text); }
</style>
