<style is:global>
  footer {
    border-top: 1px solid var(--border); padding: 40px 2rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 20px;
  }
  footer.footer-sub {
    justify-content: space-between;
  }
  .footer-logo { display: flex; align-items: center; }
  .footer-logo a { display: flex; align-items: center; text-decoration: none; }
  .footer-logo .floci-logo { height: 24px; width: auto; display: block; opacity: 0.75; transition: opacity 0.2s; }
  .footer-logo a:hover .floci-logo { opacity: 1; }
  .footer-logo .floci-logo .floci-text, .footer-logo .floci-logo .floci-cloud { fill: #F8FAFC; }
  .footer-logo .floci-logo .floci-dot { fill: #7A7FD6; }
  html.light .footer-logo .floci-logo .floci-text { fill: #262425; }
  html.light .footer-logo .floci-logo .floci-cloud { fill: #151515; }
  html.light .footer-logo .floci-logo .floci-dot { fill: #5559A7; }
  html.light .footer-logo .floci-logo { opacity: 1; }
  .footer-cols { display: flex; gap: 48px; flex-wrap: wrap; }
  .footer-col h4 { font-family: var(--mono); font-size: 11px; color: var(--text-dim); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; }
  .footer-col a { display: block; color: var(--text-dim); font-size: 13px; text-decoration: none; margin-bottom: 8px; transition: color 0.2s; }
  .footer-col a:hover { color: var(--text-muted); }
  .footer-social { display: flex; gap: 14px; align-items: center; }
  .footer-social a { color: var(--text-dim); transition: color 0.2s; }
  .footer-social a:hover { color: var(--text-muted); }
  .footer-copy { font-size: 12px; color: var(--text-dim); width: 100%; text-align: center; border-top: 1px solid var(--border); padding-top: 24px; margin-top: 8px; }
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer-links a { color: var(--text-dim); font-size: 13px; text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--text); }
</style>
