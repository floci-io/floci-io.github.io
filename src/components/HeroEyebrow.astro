---
export interface Props {
  cloud?: 'aws' | 'az' | 'gcp' | 'oci';
}

const { cloud } = Astro.props;
---

<p class:list={['hero-eyebrow', cloud && `hero-eyebrow-${cloud}`]}>
  <span class="hero-eyebrow-rule" aria-hidden="true"></span>
  <span class="hero-eyebrow-dot" aria-hidden="true"></span>
  <span class="hero-eyebrow-text"><slot /></span>
  <span class="hero-eyebrow-rule" aria-hidden="true"></span>
</p>

<style>
  .hero-eyebrow {
    --eyebrow-accent: var(--accent); --eyebrow-track: 0.18em;
    display: inline-flex; align-items: center; justify-content: center; gap: 14px;
    max-width: 100%; margin: 0 0 32px;
    font-family: var(--mono); font-size: 11.5px; line-height: 1.5;
    letter-spacing: var(--eyebrow-track); text-transform: uppercase; color: var(--text-muted);
    animation: heroEyebrowIn 0.7s cubic-bezier(.2, .7, .2, 1) both;
  }
  .hero-eyebrow-aws { --eyebrow-accent: #FF9900; }
  .hero-eyebrow-az  { --eyebrow-accent: #3A9BEF; }
  .hero-eyebrow-gcp { --eyebrow-accent: #34A853; }
  .hero-eyebrow-oci { --eyebrow-accent: #F0604D; }
  :global(html.light) .hero-eyebrow-aws { --eyebrow-accent: #B35900; }
  :global(html.light) .hero-eyebrow-az  { --eyebrow-accent: #0067B8; }
  :global(html.light) .hero-eyebrow-gcp { --eyebrow-accent: #1E7E34; }
  :global(html.light) .hero-eyebrow-oci { --eyebrow-accent: #B03A2A; }

  /* Hairlines that fade out away from the text. */
  .hero-eyebrow-rule {
    width: 56px; height: 1px; flex-shrink: 0;
    background: linear-gradient(90deg, transparent, var(--border-bright));
  }
  .hero-eyebrow-rule:last-child { background: linear-gradient(90deg, var(--border-bright), transparent); }

  /* The dot from the floci logo, with a quiet halo instead of a pulse. */
  .hero-eyebrow-dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    background: var(--eyebrow-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--eyebrow-accent) 16%, transparent);
  }
  .hero-eyebrow-text { text-wrap: balance; }

  @keyframes heroEyebrowIn {
    from { opacity: 0; letter-spacing: calc(var(--eyebrow-track) + 0.14em); }
    to { opacity: 1; letter-spacing: var(--eyebrow-track); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow { animation: none; }
  }
  @media (max-width: 600px) {
    .hero-eyebrow { gap: 10px; font-size: 10.5px; --eyebrow-track: 0.14em; }
    .hero-eyebrow-rule { display: none; }
  }
</style>
