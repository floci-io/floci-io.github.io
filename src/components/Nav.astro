---
export interface Props {
  active: 'home' | 'aws' | 'az' | 'gcp' | 'oci' | 'chronicle' | 'labs';
}

const { active } = Astro.props;

const pages = [
  { key: 'home', href: '/', label: 'Home' },
  { sep: true },
  { key: 'aws', href: '/aws/', label: 'AWS', cloud: true },
  { key: 'az', href: '/az/', label: 'Azure', cloud: true },
  { key: 'gcp', href: '/gcp/', label: 'GCP', cloud: true },
  { key: 'oci', href: '/oci/', label: 'OCI', cloud: true },
  { sep: true },
  { key: 'chronicle', href: '/chronicle/', label: 'Chronicle' },
  { key: 'labs', href: '/labs/', label: 'Labs' },
];

---

<nav aria-label="Main">
  <a class="nav-logo" href="/" aria-label="floci home">
    <svg class="floci-logo" viewBox="0 0 531.25 156.71" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <g style="isolation:isolate"><g style="isolation:isolate">
        <path class="floci-text" d="M305.44,141.35h-15.94V39.04h-17.08c-13.18,0-16.75,7.81-16.59,17.4v8.95h17.4v13.34h-17.4v62.62h-15.94v-62.62h-14.64v-13.34h14.64v-7.16c0-20.66,8.95-34.16,29.6-34.16h35.95v117.28Z"/>
        <path class="floci-text" d="M324.31,103.29c0-24.07,18.22-39.85,39.85-39.85s40.01,15.78,40.01,39.85-18.38,40.01-40.01,40.01-39.85-15.94-39.85-40.01ZM388.24,103.29c0-14.64-11.06-24.89-24.07-24.89s-23.91,10.25-23.91,24.89,10.9,25.05,23.91,25.05,24.07-10.25,24.07-25.05Z"/>
        <path class="floci-text" d="M418,103.29c0-24.07,19.03-39.85,40.99-39.85,12.36,0,22.93,5.04,29.6,13.01l-10.57,9.92c-4.39-4.88-11.06-7.97-18.71-7.97-14.15,0-25.38,10.41-25.38,24.89s11.22,25.05,25.38,25.05c7.65,0,14.31-3.09,18.71-7.97l10.57,9.92c-6.67,7.97-17.24,13.01-29.6,13.01-21.96,0-40.99-15.94-40.99-40.01Z"/>
        <path class="floci-text" d="M502.91,37.74c0-5.86,5.04-10.25,10.9-10.25s10.9,4.39,10.9,10.25-4.88,10.25-10.9,10.25-10.9-4.39-10.9-10.25ZM505.84,141.35v-75.96h15.94v75.96h-15.94Z"/>
      </g></g>
      <g>
        <path class="floci-cloud" d="M44.46,52.16l-1.44,9.05c-.1.64-35.57,8.08-30.51,43.05,2.04,14.08,14.69,31.06,31.94,31.22l84.34.78c3.64.03,7.49.5,9.97,2.81,1.69,1.57,1.95,6.1-.29,9.22l-83.49.43c-22.68.12-43.45-11.19-51.76-32.9-8.64-22.56.61-49.48,22.58-59.54,5.11-2.34,7.7-4,8.39-9.37l10.28,5.24h-.01Z"/>
        <path class="floci-cloud" d="M44.46,52.16l-10.28-5.24c1.94-15.09,10.61-28.25,23.15-36.38C74.85-.82,94.57-3.69,115.01,5.35c14.93,6.6,26.96,21.97,32.12,39.33,26.07,3.63,46.19,26.18,40.75,53.8-3.06.86-9.18-1.15-11.34-3.72,1.28-12.11-3.1-22.27-10.75-29.43-8.19-7.67-17.88-9.28-30.09-8.04-.09-25.91-19.81-43.97-43.82-45.33-22.91-1.29-43.59,16.13-47.42,40.2h0Z"/>
        <ellipse class="floci-dot" cx="173.57" cy="127.13" rx="20.36" ry="20.4"/>
        <ellipse class="floci-dot" cx="513.02" cy="37.71" rx="13.22" ry="13.25"/>
      </g>
    </svg>
  </a>
  <button class="nav-burger" id="navBurger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="navLinks">
    <div class="nav-pages">
      {pages.map(p => p.sep
        ? <div class="nav-sep" aria-hidden="true"></div>
        : <a
            href={p.href}
            class:list={['nav-page', p.cloud && `${p.key}-link`, { 'nav-active': active === p.key }]}
            aria-current={active === p.key ? 'page' : undefined}
          >{p.label}</a>
      )}
    </div>
    <div class="nav-tools">
      <a class="nav-github" href="https://github.com/floci-io" target="_blank" rel="noopener noreferrer" aria-label="floci on GitHub">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>GitHub</span>
      </a>
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
        <svg id="iconMoon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="iconSun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
    </div>
  </div>
</nav>

<style is:global>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 2rem; height: 60px; gap: 24px;
    display: flex; align-items: center; justify-content: space-between;
    background: var(--nav-bg); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border); transition: background 0.25s;
  }
  .nav-logo {
    display: flex; align-items: center;
    text-decoration: none; flex-shrink: 0;
  }
  .floci-logo { height: 32px; width: auto; display: block; transition: opacity 0.2s; }
  .nav-logo:hover .floci-logo { opacity: 0.85; }
  .floci-logo .floci-text, .floci-logo .floci-cloud { fill: #F8FAFC; }
  .floci-logo .floci-dot { fill: #7A7FD6; }
  html.light .floci-logo .floci-text { fill: #262425; }
  html.light .floci-logo .floci-cloud { fill: #151515; }
  html.light .floci-logo .floci-dot { fill: #5559A7; }

  .nav-links { display: flex; align-items: center; gap: 20px; margin-left: auto; height: 100%; }
  .nav-pages { display: flex; align-items: center; gap: 4px; height: 100%; }
  .nav-tools { display: flex; align-items: center; gap: 8px; }
  .nav-sep { width: 1px; height: 18px; margin: 0 8px; background: var(--border-bright); }

  /* Every page link has the same box in every state, so nothing moves between pages. */
  .nav-page {
    height: 100%; display: flex; align-items: center; padding: 0 10px;
    font-size: 14px; font-weight: 500; white-space: nowrap;
    color: var(--text-muted); text-decoration: none; transition: color 0.2s, box-shadow 0.2s;
  }
  .nav-page:hover, .nav-page.nav-active { color: var(--text); }
  .nav-page.nav-active { box-shadow: inset 0 -2px 0 currentColor; }
  .nav-page.aws-link:hover, .nav-page.aws-link.nav-active { color: #FF9900; }
  .nav-page.az-link:hover, .nav-page.az-link.nav-active { color: #3A9BEF; }
  .nav-page.gcp-link:hover, .nav-page.gcp-link.nav-active { color: #34A853; }
  .nav-page.oci-link:hover, .nav-page.oci-link.nav-active { color: #F0604D; }
  html.light .nav-page.aws-link:hover, html.light .nav-page.aws-link.nav-active { color: #B35900; }
  html.light .nav-page.az-link:hover, html.light .nav-page.az-link.nav-active { color: #0067B8; }
  html.light .nav-page.gcp-link:hover, html.light .nav-page.gcp-link.nav-active { color: #1E7E34; }
  html.light .nav-page.oci-link:hover, html.light .nav-page.oci-link.nav-active { color: #B03A2A; }

  .nav-github, .theme-toggle {
    height: 36px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    border: 1px solid var(--border-bright); border-radius: 8px; background: none;
    color: var(--text-muted); font-family: inherit; font-size: 13px; font-weight: 500;
    text-decoration: none; cursor: pointer; white-space: nowrap;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .nav-github { padding: 0 12px; }
  .nav-github:hover, .theme-toggle:hover { border-color: var(--accent); color: var(--text); }
  .theme-toggle { width: 36px; padding: 0; flex-shrink: 0; }
  .theme-toggle svg { display: block; }


  nav a:focus-visible, nav button:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px;
  }
  .nav-page:focus-visible { outline-offset: -4px; }

  .nav-burger {
    display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px;
    width: 44px; height: 44px; margin-right: -10px;
    background: none; border: none; cursor: pointer;
  }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--text-muted); border-radius: 2px; transition: transform 0.25s, opacity 0.25s; }
  .nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 960px) {
    nav { padding: 0 1.25rem; }
    .nav-burger { display: flex; margin-left: auto; }
    .nav-links {
      display: none; flex-direction: column; align-items: stretch; gap: 0; height: auto;
      position: fixed; top: 60px; left: 0; right: 0;
      max-height: calc(100dvh - 60px); overflow-y: auto; overscroll-behavior: contain;
      background: var(--bg2); border-bottom: 1px solid var(--border);
      padding: 8px 1.25rem 20px; z-index: 99;
    }
    .nav-links.open { display: flex; }
    .nav-pages { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-page {
      height: 48px; padding: 0 12px; font-size: 16px;
      border-bottom: 1px solid var(--border);
    }
    .nav-page.nav-active { box-shadow: inset 3px 0 0 currentColor; }
    .nav-sep { display: none; }
    .nav-tools { flex-wrap: wrap; gap: 10px; padding-top: 16px; }
    .nav-github { flex: 1; height: 44px; }
    .theme-toggle { width: 44px; height: 44px; }
  }
</style>

<script>
const burger = document.getElementById('navBurger');
const navLinks = document.getElementById('navLinks');
function setMenuOpen(open: boolean) {
  navLinks?.classList.toggle('open', open);
  burger?.setAttribute('aria-expanded', String(open));
}
if (burger && navLinks) {
  burger.addEventListener('click', () => setMenuOpen(!navLinks.classList.contains('open')));
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenuOpen(false)));
}

document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  if (navLinks?.classList.contains('open')) {
    setMenuOpen(false);
    burger?.focus();
  }
});

const html = document.documentElement;
const toggle = document.getElementById('themeToggle');
const moon = document.getElementById('iconMoon');
const sun = document.getElementById('iconSun');
function setTheme(light: boolean) {
  html.classList.toggle('light', light);
  if (moon) moon.style.display = light ? 'none' : 'block';
  if (sun) sun.style.display = light ? 'block' : 'none';
  localStorage.setItem('theme', light ? 'light' : 'dark');
}
const saved = localStorage.getItem('theme');
setTheme(saved ? saved === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches);
if (toggle) toggle.addEventListener('click', () => setTheme(!html.classList.contains('light')));
</script>
